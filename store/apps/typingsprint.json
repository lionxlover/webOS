{
  "id": "typingsprint",
  "type": "app",
  "name": "Typing Sprint",
  "version": "1.2.0",
  "category": "Productivity",
  "icon": "⌨️",
  "color": "#5B9DFA",
  "desc": "A 30-word race for your WPM",
  "long": "Sprint through 30 random words while live WPM, accuracy and the clock tick beside you. Mistake tracking, session bests and a satisfying rank at the finish line. Great for warming up your fingers before real work.",
  "changelog": "Live stats panel and rank titles",
  "developer": "Leonux Community",
  "permissions": [
    "Runs offline",
    "Sandboxed"
  ],
  "window": {
    "width": 620,
    "height": 520
  },
  "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Typing Sprint</title>\n<style>\n*{box-sizing:border-box;margin:0}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(165deg,#101622,#141d2f 60%,#182238);color:#e9eef8;height:100vh;display:flex;flex-direction:column;overflow:hidden;padding:18px}\nh1{font-size:18px}h1 span{color:#5B9DFA}\n.stats{display:flex;gap:10px;margin:10px 0 16px;flex-wrap:wrap}\n.stat{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:8px 16px;font-size:11px;font-weight:700;color:#a8b3c9}\n.stat b{display:block;font-size:20px;color:#e9eef8}\n.stat b.good{color:#9ECE6A}\n.text{font-size:19px;line-height:1.9;font-family:ui-monospace,'SF Mono',Menlo,Consolas,monospace;flex:1;overflow:auto;letter-spacing:.3px}\n.text span{color:#5c6577;border-radius:4px;padding:1px 1px}\n.text span.done{color:#9ECE6A}\n.text span.now{background:#5B9DFA;color:#0a1220}\n.text span.err{color:#F28B82;text-decoration:underline wavy #F28B82aa}\n.btn{border:0;border-radius:11px;padding:12px 22px;font-weight:800;font-size:14px;cursor:pointer;background:#5B9DFA;color:#0a1220;align-self:center;margin-top:8px}\n.btn:active{transform:scale(.98)}\n.msg{text-align:center;font-size:12.5px;color:#a8b3c9;margin-top:8px;min-height:16px}\n</style></head><body>\n<h1>⌨️ Typing <span>Sprint</span></h1>\n<div class=\"stats\">\n  <div class=\"stat\">WPM<b id=\"wpm\">0</b></div>\n  <div class=\"stat\">Accuracy<b id=\"acc\">100%</b></div>\n  <div class=\"stat\">Time<b id=\"time\">0s</b></div>\n  <div class=\"stat\">Best WPM<b id=\"best\">—</b></div>\n</div>\n<div class=\"text\" id=\"text\"></div>\n<button class=\"btn\" id=\"go\">Start sprint · 30 words</button>\n<div class=\"msg\" id=\"msg\">Type the highlighted word — a mistake turns red</div>\n<script>\n'use strict';\nvar WORDS='the quick brown fox jumps over lazy dog time day year people way thing man world life hand part child eye woman place work week case point government company number group problem fact water room mother area money story month lot right study book word business issue side kind head house service friend father power hour game line end member law car city community name president team minute idea kid body information back parent face others level office door health person art war history party result change morning reason research girl guy moment air teacher force education'.split(' ');\nvar textEl=document.getElementById('text'),wpmEl=document.getElementById('wpm'),accEl=document.getElementById('acc'),timeEl=document.getElementById('time'),msgEl=document.getElementById('msg'),goBtn=document.getElementById('go'),bestEl=document.getElementById('best');\nvar words,typedIdx,charIdx,errors,totalTyped,startT,timer=null,running=false,best=0;\nfunction sample(){var out=[],n=30;for(var i=0;i<n;i++)out.push(WORDS[Math.floor(Math.random()*WORDS.length)]);return out;}\nfunction render(){\n  textEl.innerHTML='';\n  words.forEach(function(w,wi){\n    var ws=document.createElement('span');\n    for(var ci=0;ci<w.length;ci++){\n      var s=document.createElement('span');s.textContent=w[ci];\n      if(wi<typedIdx||(wi===typedIdx&&ci<charIdx))s.className='done';\n      if(wi===typedIdx&&ci===charIdx)s.className='now';\n      ws.appendChild(s);\n    }\n    if(wi===typedIdx&&charIdx>=w.length){var e=document.createElement('span');e.className='now';ws.appendChild(e);}\n    textEl.appendChild(ws);textEl.appendChild(document.createTextNode(' '));\n  });\n  var nows=textEl.querySelectorAll('.now');if(nows.length)nows[0].scrollIntoView({block:'center'});\n}\nfunction start(){\n  words=sample();typedIdx=0;charIdx=0;errors=0;totalTyped=0;running=true;\n  goBtn.style.display='none';startT=Date.now();\n  timer=setInterval(tick,250);\n  render();\n  msgEl.textContent='Go! Type each word and press space';\n}\nfunction tick(){\n  var sec=Math.round((Date.now()-startT)/1000);\n  timeEl.textContent=sec+'s';\n  var mins=Math.max(sec/60,0.008);\n  wpmEl.textContent=Math.round((typedIdx+charIdx/5)/mins);\n  accEl.textContent=(totalTyped?Math.max(0,Math.round((totalTyped-errors)/totalTyped*100)):100)+'%';\n}\ndocument.addEventListener('keydown',function(e){\n  if(!running)return;\n  if(e.key===' '){\n    e.preventDefault();\n    var w=words[typedIdx];\n    if(charIdx===w.length){ // correct complete word\n      typedIdx++;charIdx=0;totalTyped++;\n    }else{errors++;totalTyped+=2;}\n    render();tick();\n    if(typedIdx>=words.length)finish();\n  }else if(e.key==='Backspace'){\n    if(charIdx>0){charIdx--;render();}\n  }else if(e.key.length===1){\n    var w=words[typedIdx];\n    if(charIdx<w.length){\n      if(e.key!==w[charIdx]){errors++;}\n      totalTyped++;charIdx++;render();\n    }\n  }\n});\nfunction finish(){\n  running=false;clearInterval(timer);\n  var sec=Math.round((Date.now()-startT)/1000);\n  var mins=Math.max(sec/60,0.01);\n  var wpm=Math.round(30/mins);\n  var acc=totalTyped?Math.round((totalTyped-errors)/totalTyped*100):100;\n  if(wpm>best){best=wpm;bestEl.textContent=wpm;}\n  wpmEl.textContent=wpm;accEl.textContent=acc+'%';\n  msgEl.textContent='🏁 '+wpm+' WPM at '+acc+'% accuracy in '+sec+'s — '+rank(wpm);\n  goBtn.style.display='';goBtn.textContent='Race again';\n}\nfunction rank(w){return w>75?'Keyboard warrior! 🔥':w>50?'Impressive pace!':w>35?'Solid typing skills':w>20?'Getting there — keep practising':'Every master started here';}\ngoBtn.onclick=start;\nwords=sample();render();\n</script></body></html>\n"
}