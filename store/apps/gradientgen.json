{
 "id": "gradientgen",
 "type": "app",
 "name": "Gradient Studio",
 "version": "1.0.0",
 "category": "Design",
 "icon": "🌈",
 "color": "#c084fc",
 "desc": "Build CSS gradients visually and copy the code",
 "long": "Linear, radial and conic gradients with up to eight colour stops, a live preview, randomise button and one-click CSS copy.",
 "changelog": "First release",
 "developer": "Leonux Community",
 "permissions": [
  "Runs offline",
  "Sandboxed"
 ],
 "window": {
  "width": 520,
  "height": 640,
  "minWidth": 380,
  "minHeight": 520
 },
 "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title> Gradient Studio</title><style>*{box-sizing:border-box;margin:0}\n:root{--bg:#10131c;--fg:#e8ecf6;--mut:#8b94ab;--ac:#7EE787;--line:rgba(255,255,255,.1);--card:rgba(255,255,255,.05)}\nhtml,body{height:100%}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(165deg,#10131c,#161a28);color:var(--fg);overflow:hidden;user-select:none;-webkit-user-select:none}\nbutton{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.08);border:1px solid var(--line);border-radius:9px;padding:7px 13px;cursor:pointer;transition:background .12s,transform .08s}\nbutton:hover{background:rgba(255,255,255,.15)}button:active{transform:scale(.96)}\nbutton.pri{background:var(--ac);color:#0b1020;border-color:transparent;font-weight:700}\ninput,select,textarea{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.07);border:1px solid var(--line);border-radius:8px;padding:6px 9px;outline:none;user-select:text;-webkit-user-select:text}\ninput:focus,select:focus,textarea:focus{border-color:var(--ac)}select option{background:#1b2030}\n.wrap{height:100%;display:flex;flex-direction:column;align-items:center;gap:10px;padding:14px;overflow:auto}\n.bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:center}\n.stat{font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:.06em;text-align:center}.stat b{display:block;color:var(--ac);font-size:20px;letter-spacing:0}\nh1{font-size:16px}h1 span{color:var(--ac)}\n.muted{color:var(--mut);font-size:12px}\ncanvas{display:block;max-width:100%}\nlabel{font-size:12px;color:var(--mut)}\n.wrap{align-items:stretch}#pv{height:150px;border-radius:14px;border:1px solid var(--line);flex:none}\n.stops{display:flex;flex-direction:column;gap:6px}.stop{display:flex;gap:8px;align-items:center}.stop input[type=color]{width:38px;height:28px;padding:0;border:0;background:none}.stop input[type=range]{flex:1}\npre{background:rgba(0,0,0,.35);border-radius:9px;padding:10px;font:12px ui-monospace,monospace;white-space:pre-wrap;user-select:text;-webkit-user-select:text;color:#cde}\n</style></head><body><div class=\"wrap\">\n<h1>Gradient <span>Studio</span></h1><div id=\"pv\"></div>\n<div class=\"bar\"><select id=\"ty\"><option value=\"linear\">Linear</option><option value=\"radial\">Radial</option><option value=\"conic\">Conic</option></select><label>Angle <input id=\"an\" type=\"range\" min=\"0\" max=\"360\" value=\"135\"></label><button id=\"add\">+ Stop</button><button id=\"rnd\">Random</button></div>\n<div class=\"stops\" id=\"st\"></div><pre id=\"css\"></pre><button class=\"pri\" id=\"cp\">Copy CSS</button>\n</div><script>\nconst $=s=>document.querySelector(s);let S=[['#7EE787',0],['#4f8cff',55],['#c084fc',100]];\nfunction css(){const st=S.slice().sort((a,b)=>a[1]-b[1]).map(s=>s[0]+' '+s[1]+'%').join(', '),a=$('#an').value,t=$('#ty').value;return t=='linear'?'linear-gradient('+a+'deg, '+st+')':t=='radial'?'radial-gradient(circle at center, '+st+')':'conic-gradient(from '+a+'deg, '+st+')'}\nfunction render(){$('#st').innerHTML='';S.forEach((s,i)=>{const d=document.createElement('div');d.className='stop';d.innerHTML='<input type=\"color\" value=\"'+s[0]+'\"><input type=\"range\" min=\"0\" max=\"100\" value=\"'+s[1]+'\"><span class=\"muted\" style=\"width:34px\">'+s[1]+'%</span><button>&times;</button>';\n d.children[0].oninput=e=>{s[0]=e.target.value;upd()};d.children[1].oninput=e=>{s[1]=+e.target.value;d.children[2].textContent=s[1]+'%';upd()};d.children[3].onclick=()=>{if(S.length>2){S.splice(i,1);render()}};$('#st').appendChild(d)});upd()}\nfunction upd(){const c=css();$('#pv').style.background=c;$('#css').textContent='background: '+c+';'}\nconst rc=()=>'#'+Math.floor(Math.random()*16777215).toString(16).padStart(6,'0');\n$('#add').onclick=()=>{if(S.length<8){S.push([rc(),100]);render()}};$('#rnd').onclick=()=>{S=S.map((s,i)=>[rc(),s[1]]);$('#an').value=Math.random()*360|0;render()};\n$('#ty').onchange=upd;$('#an').oninput=upd;\n$('#cp').onclick=()=>{const t=$('#css').textContent;navigator.clipboard?navigator.clipboard.writeText(t).then(()=>$('#cp').textContent='Copied!',()=>{getSelection().selectAllChildren($('#css'))}):getSelection().selectAllChildren($('#css'));setTimeout(()=>$('#cp').textContent='Copy CSS',1200)};render();\n</script></body></html>\n"
}