{
 "id": "sortviz",
 "type": "app",
 "name": "Sort Visualizer",
 "version": "1.0.0",
 "category": "Education",
 "icon": "📊",
 "color": "#fb7185",
 "desc": "Watch six sorting algorithms race",
 "long": "Bubble, insertion, selection, quick, merge and heap sort animated on up to 150 bars with adjustable speed and a comparison counter.",
 "changelog": "First release",
 "developer": "Leonux Community",
 "permissions": [
  "Runs offline",
  "Sandboxed"
 ],
 "window": {
  "width": 640,
  "height": 460,
  "minWidth": 400,
  "minHeight": 320
 },
 "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Sort Visualizer</title><style>*{box-sizing:border-box;margin:0}\n:root{--bg:#10131c;--fg:#e8ecf6;--mut:#8b94ab;--ac:#7EE787;--line:rgba(255,255,255,.1);--card:rgba(255,255,255,.05)}\nhtml,body{height:100%}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(165deg,#10131c,#161a28);color:var(--fg);overflow:hidden;user-select:none;-webkit-user-select:none}\nbutton{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.08);border:1px solid var(--line);border-radius:9px;padding:7px 13px;cursor:pointer;transition:background .12s,transform .08s}\nbutton:hover{background:rgba(255,255,255,.15)}button:active{transform:scale(.96)}\nbutton.pri{background:var(--ac);color:#0b1020;border-color:transparent;font-weight:700}\ninput,select,textarea{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.07);border:1px solid var(--line);border-radius:8px;padding:6px 9px;outline:none;user-select:text;-webkit-user-select:text}\ninput:focus,select:focus,textarea:focus{border-color:var(--ac)}select option{background:#1b2030}\n.wrap{height:100%;display:flex;flex-direction:column;align-items:center;gap:10px;padding:14px;overflow:auto}\n.bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:center}\n.stat{font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:.06em;text-align:center}.stat b{display:block;color:var(--ac);font-size:20px;letter-spacing:0}\nh1{font-size:16px}h1 span{color:var(--ac)}\n.muted{color:var(--mut);font-size:12px}\ncanvas{display:block;max-width:100%}\nlabel{font-size:12px;color:var(--mut)}\n.wrap{padding:10px}canvas{width:100%;flex:1;min-height:0;background:#05070d;border-radius:12px}\n</style></head><body><div class=\"wrap\">\n<div class=\"bar\"><select id=\"al\"><option value=\"bubble\">Bubble sort</option><option value=\"insertion\">Insertion sort</option><option value=\"selection\">Selection sort</option><option value=\"quick\">Quick sort</option><option value=\"merge\">Merge sort</option><option value=\"heap\">Heap sort</option></select>\n<label>Size <input id=\"n\" type=\"range\" min=\"10\" max=\"150\" value=\"60\"></label><label>Speed <input id=\"sp\" type=\"range\" min=\"1\" max=\"10\" value=\"6\"></label><button id=\"sh\">Shuffle</button><button class=\"pri\" id=\"go\">Sort</button></div>\n<canvas id=\"c\"></canvas><div class=\"muted\" id=\"m\"></div>\n</div><script>\nconst cv=document.getElementById('c'),x=cv.getContext('2d'),$=s=>document.querySelector(s);let A=[],hl={},busy=false,stop=false,ops=0;\nfunction fit(){const r=cv.getBoundingClientRect();cv.width=r.width;cv.height=r.height;draw()}addEventListener('resize',fit);\nfunction shuffle(){stop=true;A=Array.from({length:+$('#n').value},(_,i)=>i+1);for(let i=A.length-1;i>0;i--){const j=Math.random()*(i+1)|0;[A[i],A[j]]=[A[j],A[i]]}hl={};ops=0;$('#m').textContent='';draw()}\nfunction draw(){x.clearRect(0,0,cv.width,cv.height);const w=cv.width/A.length,mx=A.length;A.forEach((v,i)=>{const h=v/mx*(cv.height-6);x.fillStyle=hl[i]||'hsl('+(v/mx*260+100)+',70%,55%)';x.fillRect(i*w+.5,cv.height-h,Math.max(1,w-1),h)})}\nconst sleep=()=>new Promise(r=>setTimeout(r,Math.max(0,(11-$('#sp').value)*(11-$('#sp').value)/6)));\nasync function cmp(i,j){hl={[i]:'#fff',[j]:'#f43f5e'};ops++;draw();await sleep();if(stop)throw 0}\nasync function swp(i,j){[A[i],A[j]]=[A[j],A[i]];draw()}\nconst ALG={\n async bubble(){for(let i=0;i<A.length;i++)for(let j=0;j<A.length-i-1;j++){await cmp(j,j+1);if(A[j]>A[j+1])await swp(j,j+1)}},\n async insertion(){for(let i=1;i<A.length;i++)for(let j=i;j>0;j--){await cmp(j,j-1);if(A[j]<A[j-1])await swp(j,j-1);else break}},\n async selection(){for(let i=0;i<A.length;i++){let m=i;for(let j=i+1;j<A.length;j++){await cmp(j,m);if(A[j]<A[m])m=j}await swp(i,m)}},\n async quick(l=0,r=A.length-1){if(l>=r)return;const p=A[r];let i=l;for(let j=l;j<r;j++){await cmp(j,r);if(A[j]<p)await swp(i++,j)}await swp(i,r);await ALG.quick(l,i-1);await ALG.quick(i+1,r)},\n async merge(l=0,r=A.length-1){if(l>=r)return;const m=l+r>>1;await ALG.merge(l,m);await ALG.merge(m+1,r);const L=A.slice(l,m+1),R=A.slice(m+1,r+1);let i=0,j=0,k=l;while(i<L.length||j<R.length){await cmp(k,Math.min(r,m+1+j));A[k++]=j>=R.length||(i<L.length&&L[i]<=R[j])?L[i++]:R[j++];draw()}},\n async heap(){const n=A.length;async function sift(i,n){for(;;){let l=2*i+1,r=l+1,m=i;if(l<n){await cmp(l,m);if(A[l]>A[m])m=l}if(r<n){await cmp(r,m);if(A[r]>A[m])m=r}if(m==i)return;await swp(i,m);i=m}}\n  for(let i=n>>1;i>=0;i--)await sift(i,n);for(let e=n-1;e>0;e--){await swp(0,e);await sift(0,e)}}};\n$('#go').onclick=async()=>{if(busy)return;busy=true;stop=false;ops=0;try{await ALG[$('#al').value]();hl={};for(let i=0;i<A.length;i++){hl={[i]:'#7EE787'};draw();await new Promise(r=>setTimeout(r,6))}hl={};draw();$('#m').textContent='Sorted — '+ops+' comparisons'}catch(e){}busy=false};\n$('#sh').onclick=()=>{shuffle()};$('#n').oninput=shuffle;shuffle();fit();\n</script></body></html>\n"
}