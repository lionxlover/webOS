{
 "id": "numberbase",
 "type": "app",
 "name": "Base Converter",
 "version": "1.0.0",
 "category": "Utilities",
 "icon": "💾",
 "color": "#22d3ee",
 "desc": "Decimal, binary, octal, hex and any base to 36",
 "long": "Edit any field and the others follow. Includes a 32-bit toggle grid, an ASCII preview and a custom base up to 36.",
 "changelog": "First release",
 "developer": "Leonux Community",
 "permissions": [
  "Runs offline",
  "Sandboxed"
 ],
 "window": {
  "width": 540,
  "height": 560,
  "minWidth": 380,
  "minHeight": 460
 },
 "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Base Converter</title><style>*{box-sizing:border-box;margin:0}\n:root{--bg:#10131c;--fg:#e8ecf6;--mut:#8b94ab;--ac:#7EE787;--line:rgba(255,255,255,.1);--card:rgba(255,255,255,.05)}\nhtml,body{height:100%}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(165deg,#10131c,#161a28);color:var(--fg);overflow:hidden;user-select:none;-webkit-user-select:none}\nbutton{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.08);border:1px solid var(--line);border-radius:9px;padding:7px 13px;cursor:pointer;transition:background .12s,transform .08s}\nbutton:hover{background:rgba(255,255,255,.15)}button:active{transform:scale(.96)}\nbutton.pri{background:var(--ac);color:#0b1020;border-color:transparent;font-weight:700}\ninput,select,textarea{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.07);border:1px solid var(--line);border-radius:8px;padding:6px 9px;outline:none;user-select:text;-webkit-user-select:text}\ninput:focus,select:focus,textarea:focus{border-color:var(--ac)}select option{background:#1b2030}\n.wrap{height:100%;display:flex;flex-direction:column;align-items:center;gap:10px;padding:14px;overflow:auto}\n.bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:center}\n.stat{font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:.06em;text-align:center}.stat b{display:block;color:var(--ac);font-size:20px;letter-spacing:0}\nh1{font-size:16px}h1 span{color:var(--ac)}\n.muted{color:var(--mut);font-size:12px}\ncanvas{display:block;max-width:100%}\nlabel{font-size:12px;color:var(--mut)}\n.wrap{align-items:stretch;max-width:520px;margin:auto}.g{display:grid;grid-template-columns:90px 1fr;gap:8px;align-items:center}.g input{font-family:ui-monospace,Menlo,monospace;font-size:15px}.g input.bad{border-color:#ef4444}\n.bits button{padding:6px 0;font:12px ui-monospace,monospace}.bits .on{background:var(--ac);color:#0b1020}\n.grp{display:grid;grid-template-columns:repeat(16,1fr);gap:3px}.bits button{width:auto}\n</style></head><body><div class=\"wrap\">\n<h1>Base <span>Converter</span></h1>\n<div class=\"g\"><label>Decimal</label><input id=\"d\" inputmode=\"numeric\"><label>Binary</label><input id=\"b\"><label>Octal</label><input id=\"o\"><label>Hex</label><input id=\"h\"><label>Base <input id=\"cb\" type=\"number\" min=\"2\" max=\"36\" value=\"5\" style=\"width:60px\"></label><input id=\"cv\"></div>\n<div class=\"muted\" style=\"text-align:center\">Toggle bits (32-bit, click to flip)</div><div class=\"grp bits\" id=\"bt\"></div>\n<div class=\"muted\" id=\"m\" style=\"text-align:center\"></div>\n</div><script>\nconst $=s=>document.querySelector(s),F=[['d',10],['b',2],['o',8],['h',16]];let val=0n;\nconst valid=(s,b)=>{s=s.trim().toLowerCase();if(!s)return null;for(const c of s){const v=parseInt(c,36);if(isNaN(v)||v>=b)return false}return true};\nfunction parse(s,b){let r=0n;for(const c of s.trim().toLowerCase())r=r*BigInt(b)+BigInt(parseInt(c,36));return r}\nfunction show(skip){F.forEach(([id,b])=>{if(id!=skip)$('#'+id).value=val.toString(b).toUpperCase();$('#'+id).className=''});const cb=+$('#cb').value||5;if(skip!='cv')$('#cv').value=val.toString(Math.min(36,Math.max(2,cb))).toUpperCase();\n const v=Number(val&0xFFFFFFFFn);document.querySelectorAll('#bt button').forEach(b=>{const on=(v>>>(31-b.dataset.i))&1;b.className=on?'on':'';b.textContent=on});$('#m').textContent=val>0xFFFFFFFFn?'Value exceeds 32 bits':'ASCII: '+(val>31n&&val<127n?String.fromCharCode(Number(val)):'(non-printable)')}\nF.forEach(([id,b])=>{$('#'+id).oninput=e=>{const s=e.target.value,v=valid(s,b);e.target.className=v===false?'bad':'';if(v){val=parse(s,b);show(id)}else if(v===null){val=0n;show(id)}}});\n$('#cv').oninput=e=>{const b=+$('#cb').value||5,v=valid(e.target.value,b);e.target.className=v===false?'bad':'';if(v){val=parse(e.target.value,b);show('cv')}};$('#cb').oninput=()=>show();\nfor(let i=0;i<32;i++){const b=document.createElement('button');b.textContent=0;b.dataset.i=i;b.onclick=()=>{val=(val&0xFFFFFFFFn)^(1n<<BigInt(31-i));show()};$('#bt').appendChild(b);}\nval=2026n;show();\n</script></body></html>\n"
}