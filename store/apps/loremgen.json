{
 "id": "loremgen",
 "type": "app",
 "name": "Lorem Forge",
 "version": "1.0.0",
 "category": "Utilities",
 "icon": "📝",
 "color": "#fcd34d",
 "desc": "Placeholder text in four flavours",
 "long": "Generate paragraphs, sentences or words in classic Latin, hipster, corporate-tech or space-opera vocabularies — then copy.",
 "changelog": "First release",
 "developer": "Leonux Community",
 "permissions": [
  "Runs offline",
  "Sandboxed"
 ],
 "window": {
  "width": 560,
  "height": 520,
  "minWidth": 380,
  "minHeight": 400
 },
 "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Lorem Forge</title><style>*{box-sizing:border-box;margin:0}\n:root{--bg:#10131c;--fg:#e8ecf6;--mut:#8b94ab;--ac:#7EE787;--line:rgba(255,255,255,.1);--card:rgba(255,255,255,.05)}\nhtml,body{height:100%}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(165deg,#10131c,#161a28);color:var(--fg);overflow:hidden;user-select:none;-webkit-user-select:none}\nbutton{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.08);border:1px solid var(--line);border-radius:9px;padding:7px 13px;cursor:pointer;transition:background .12s,transform .08s}\nbutton:hover{background:rgba(255,255,255,.15)}button:active{transform:scale(.96)}\nbutton.pri{background:var(--ac);color:#0b1020;border-color:transparent;font-weight:700}\ninput,select,textarea{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.07);border:1px solid var(--line);border-radius:8px;padding:6px 9px;outline:none;user-select:text;-webkit-user-select:text}\ninput:focus,select:focus,textarea:focus{border-color:var(--ac)}select option{background:#1b2030}\n.wrap{height:100%;display:flex;flex-direction:column;align-items:center;gap:10px;padding:14px;overflow:auto}\n.bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:center}\n.stat{font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:.06em;text-align:center}.stat b{display:block;color:var(--ac);font-size:20px;letter-spacing:0}\nh1{font-size:16px}h1 span{color:var(--ac)}\n.muted{color:var(--mut);font-size:12px}\ncanvas{display:block;max-width:100%}\nlabel{font-size:12px;color:var(--mut)}\n.wrap{align-items:stretch}#o{flex:1;min-height:140px;background:rgba(0,0,0,.3);border:1px solid var(--line);border-radius:10px;padding:12px;font-size:14px;line-height:1.55;overflow:auto;user-select:text;-webkit-user-select:text}#o p{margin:0 0 .8em}\n</style></head><body><div class=\"wrap\">\n<h1>Lorem <span>Forge</span></h1>\n<div class=\"bar\"><select id=\"th\"><option value=\"lorem\">Classic Latin</option><option value=\"hip\">Hipster</option><option value=\"tech\">Corporate tech</option><option value=\"space\">Space opera</option></select>\n<label>Paragraphs <input id=\"n\" type=\"number\" min=\"1\" max=\"20\" value=\"3\" style=\"width:56px\"></label><label><input type=\"checkbox\" id=\"cl\" checked> Start with classic line</label>\n<select id=\"u\"><option value=\"p\">Paragraphs</option><option value=\"s\">Sentences</option><option value=\"w\">Words</option></select><button class=\"pri\" id=\"g\">Generate</button></div>\n<div id=\"o\"></div><div class=\"bar\"><button id=\"cp\">Copy text</button><span class=\"muted\" id=\"m\"></span></div>\n</div><script>\nconst W={lorem:'lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore magna aliqua enim ad minim veniam quis nostrud exercitation ullamco laboris nisi aliquip ex ea commodo consequat duis aute irure in reprehenderit voluptate velit esse cillum fugiat nulla pariatur excepteur sint occaecat cupidatat non proident sunt culpa qui officia deserunt mollit anim id est laborum',\nhip:'artisan kombucha sriracha vinyl cold-pressed tote bag fixie letterpress selvage flannel pour-over sustainable organic gluten-free vegan beard bicycle skateboard typewriter cardigan mustache thundercats retro ethical aesthetic gastropub tattooed microdosing banjo locavore pickled raw denim',\ntech:'synergy scalable paradigm stakeholder deliverable leverage cloud-native pipeline roadmap agile sprint backlog throughput bandwidth ecosystem disrupt iterate platform workflow onboarding KPI dashboard metrics holistic mission-critical best-practice alignment innovation bleeding-edge infrastructure',\nspace:'nebula starship warp reactor captain galaxy plasma quantum hyperdrive asteroid orbit cosmic fleet cruiser stardust wormhole gravity photon comet void pulsar outpost colony engines shields beacon voyage horizon alien signal'};\nconst $=s=>document.querySelector(s),pick=a=>a[Math.random()*a.length|0],CL='Lorem ipsum dolor sit amet, consectetur adipiscing elit.';\nfunction sentence(w){const n=6+Math.random()*10|0;let a=[];for(let i=0;i<n;i++)a.push(pick(w));if(n>9&&Math.random()<.6)a.splice(4+Math.random()*3|0,0,a.splice(4,1)[0]+',');const s=a.join(' ');return s[0].toUpperCase()+s.slice(1)+'.'}\nfunction gen(){const w=W[$('#th').value].split(' '),u=$('#u').value,n=Math.max(1,+$('#n').value||1);let out=[];\n if(u=='w'){const a=[];for(let i=0;i<n*10;i++)a.push(pick(w));out=[a.join(' ')]}\n else if(u=='s'){const a=[];for(let i=0;i<n*3;i++)a.push(sentence(w));out=[a.join(' ')]}\n else for(let i=0;i<n;i++){const a=[];for(let j=0;j<3+Math.random()*4|0;j++)a.push(sentence(w));out.push(a.join(' '))}\n if($('#cl').checked&&$('#th').value=='lorem'&&out.length)out[0]=CL+' '+out[0];\n $('#o').innerHTML=out.map(p=>'<p>'+p+'</p>').join('');const t=out.join(' ');$('#m').textContent=t.split(/\\s+/).length+' words · '+t.length+' chars'}\n$('#g').onclick=gen;$('#th').onchange=gen;\n$('#cp').onclick=()=>{const t=[...$('#o').children].map(p=>p.textContent).join('\\n\\n');navigator.clipboard?navigator.clipboard.writeText(t).then(()=>$('#m').textContent='Copied to clipboard',()=>getSelection().selectAllChildren($('#o'))):getSelection().selectAllChildren($('#o'))};gen();\n</script></body></html>\n"
}