{
  "id": "pixelart",
  "type": "app",
  "name": "Pixel Art Studio",
  "version": "1.2.0",
  "category": "Media",
  "icon": "🎨",
  "color": "#FF9ECD",
  "desc": "Draw 16×16 pixel art and export PNG",
  "long": "A pocket pixel editor: 12-colour palette, pen, flood-fill bucket and eraser on a 16×16 canvas, with a live miniature preview and one-tap PNG export at 16× zoom. Ships with a starter heart so you can start remixing immediately.",
  "changelog": "Flood-fill bucket tool and in-app export",
  "developer": "Leonux Community",
  "permissions": [
    "Runs offline",
    "Sandboxed"
  ],
  "window": {
    "width": 560,
    "height": 570
  },
  "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Pixel Art Studio</title>\n<style>\n*{box-sizing:border-box;margin:0}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(165deg,#16131f,#1d1929 60%,#241f33);color:#efedf6;height:100vh;display:flex;flex-direction:column;overflow:hidden;user-select:none;padding:14px}\nh1{font-size:17px}h1 span{color:#CBA6F7}\n.top{display:flex;gap:10px;align-items:center;margin:8px 0 10px;flex-wrap:wrap}\n.tools{display:flex;gap:6px}\n.tool{width:34px;height:34px;border-radius:10px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);color:#d6d1e6;font-size:15px;cursor:pointer;display:grid;place-items:center;font-weight:700}\n.tool.on{background:#CBA6F7;color:#221a33;border-color:#CBA6F7}\n.pal{display:flex;gap:5px;flex-wrap:wrap}\n.sw{width:26px;height:26px;border-radius:8px;cursor:pointer;border:2px solid transparent}\n.sw.on{border-color:#fff;transform:scale(1.12)}\n.stage{flex:1;display:grid;place-items:center;min-height:0}\ncanvas{background:#fff;border-radius:12px;box-shadow:0 16px 40px -12px rgba(0,0,0,.6);image-rendering:pixelated;touch-action:none;max-width:100%;max-height:100%}\n.foot{display:flex;gap:8px;align-items:center;margin-top:10px;font-size:11.5px;color:#a9a3bd;flex-wrap:wrap}\n.btn{border:0;border-radius:10px;padding:8px 14px;font-weight:700;font-size:12px;cursor:pointer;background:rgba(255,255,255,.08);color:#efedf6}\n.btn.p{background:#CBA6F7;color:#221a33}\n.preview{width:44px;height:44px;border-radius:8px;background:#fff;image-rendering:pixelated;border:1px solid rgba(255,255,255,.2)}\n</style></head><body>\n<h1>🖼 Pixel Art <span>Studio</span></h1>\n<div class=\"top\">\n  <div class=\"tools\">\n    <div class=\"tool on\" id=\"tPen\" title=\"Draw\">✏️</div>\n    <div class=\"tool\" id=\"tFill\" title=\"Fill bucket\">🪣</div>\n    <div class=\"tool\" id=\"tErase\" title=\"Eraser\">🧽</div>\n  </div>\n  <div class=\"pal\" id=\"pal\"></div>\n  <span style=\"flex:1\"></span>\n  <button class=\"btn\" id=\"clear\">Clear</button>\n  <button class=\"btn p\" id=\"save\">⬇ Export PNG</button>\n</div>\n<div class=\"stage\"><canvas id=\"cv\" width=\"16\" height=\"16\"></canvas></div>\n<div class=\"foot\"><canvas class=\"preview\" id=\"pv\" width=\"16\" height=\"16\"></canvas> <span>16×16 canvas · drag to draw · exports at 16× zoom</span></div>\n<script>\n'use strict';\nvar COLORS=['#000000','#ffffff','#f28b82','#f6c177','#9ece6a','#4dd0e1','#5b9dfa','#cba6f7','#f48fb1','#8b572a','#e0af68','#5c6370'];\nvar N=16,cv=document.getElementById('cv'),ctx=cv.getContext('2d'),pv=document.getElementById('pv'),pctx=pv.getContext('2d');\nvar grid=[],color=COLORS[0],tool='pen',drawing=false,lastCell=-1;\nfunction blank(){grid=Array(N*N).fill(null);}\nfunction cellAt(e){\n  var r=cv.getBoundingClientRect();\n  var x=Math.floor((e.clientX-r.left)/r.width*N),y=Math.floor((e.clientY-r.top)/r.height*N);\n  if(x<0||y<0||x>=N||y>=N)return -1;return y*N+x;\n}\nfunction paint(){\n  ctx.fillStyle='#fff';ctx.fillRect(0,0,N,N);\n  for(var i=0;i<grid.length;i++){\n    if(grid[i]==null)continue;\n    ctx.fillStyle=grid[i];\n    ctx.fillRect(i%N,Math.floor(i/N),1,1);\n  }\n  pctx.fillStyle='#fff';pctx.fillRect(0,0,N,N);\n  pctx.putImageData(ctx.getImageData(0,0,N,N),0,0);\n}\nfunction apply(i){\n  if(i<0)return;\n  if(tool==='erase')grid[i]=null;\n  else if(tool==='fill'){var target=grid[i],c=tool==='fill'?color:color;flood(i,target);}\n  else grid[i]=color;\n  paint();\n}\nfunction flood(start,target){\n  if(target===color)return;\n  var stack=[start],seen={};\n  while(stack.length){\n    var i=stack.pop();\n    if(seen[i]||i<0||i>=N*N)continue;seen[i]=1;\n    if(grid[i]!==target)continue;\n    grid[i]=color;\n    var x=i%N;\n    if(x>0)stack.push(i-1);if(x<N-1)stack.push(i+1);\n    stack.push(i-N);stack.push(i+N);\n  }\n}\nfunction pos(e){return e.touches?e.touches[0]:e;}\ncv.addEventListener('pointerdown',function(e){e.preventDefault();drawing=true;lastCell=cellAt(e);apply(lastCell);});\ncv.addEventListener('pointermove',function(e){if(!drawing)return;var c=cellAt(e);if(c!==lastCell){lastCell=c;apply(c);}});\nwindow.addEventListener('pointerup',function(){drawing=false;});\nvar pal=document.getElementById('pal');\nCOLORS.forEach(function(c,i){\n  var s=document.createElement('div');s.className='sw'+(i===0?' on':'');s.style.background=c;\n  s.onclick=function(){color=c;tool=tool==='erase'?'pen':tool;paintTools();Array.prototype.forEach.call(pal.children,function(x){x.classList.remove('on');});s.classList.add('on');};\n  pal.appendChild(s);\n});\nfunction paintTools(){\n  document.getElementById('tPen').classList.toggle('on',tool==='pen');\n  document.getElementById('tFill').classList.toggle('on',tool==='fill');\n  document.getElementById('tErase').classList.toggle('on',tool==='erase');\n}\ndocument.getElementById('tPen').onclick=function(){tool='pen';paintTools();};\ndocument.getElementById('tFill').onclick=function(){tool='fill';paintTools();};\ndocument.getElementById('tErase').onclick=function(){tool='erase';paintTools();};\ndocument.getElementById('clear').onclick=function(){blank();paint();};\ndocument.getElementById('save').onclick=function(){\n  var big=document.createElement('canvas');big.width=N*16;big.height=N*16;\n  var bctx=big.getContext('2d');bctx.imageSmoothingEnabled=false;\n  bctx.drawImage(cv,0,0,big.width,big.height);\n  var url=big.toDataURL('image/png');\n  var w=window.open('about:blank');\n  if(w){w.document.write('<title>Your pixel art</title><body style=\"margin:0;background:#111;display:grid;place-items:center;height:100vh\"><img src=\"'+url+'\" style=\"image-rendering:pixelated;width:70vw\"><p style=\"color:#999;font-family:sans-serif;position:fixed;bottom:12px\">Right-click (or long-press) the image to save</p></body>');}\n  else{ // popup blocked — show in-place\n    var img=new Image();img.src=url;img.style.cssText='image-rendering:pixelated;max-width:100%;border-radius:12px';\n    var st=document.querySelector('.stage');st.innerHTML='';st.appendChild(img);\n  }\n};\nblank();\n// draw a starter heart so it isn't empty\n(function(){\n  var H=['................','...xx....xx.....','..xxxx..xxxx....','..xxxxxxxxxxx...','..xxxxxxxxxxx...','...xxxxxxxxx....','....xxxxxxx.....','.....xxxxx......','......xxx.......','.......x........'];\n  for(var y=0;y<H.length;y++)for(var x=0;x<16;x++)if(H[y][x]==='x')grid[y*N+x]='#F28B82';\n  paint();\n})();\n</script></body></html>\n"
}