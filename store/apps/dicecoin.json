{
  "id": "dicecoin",
  "type": "app",
  "name": "Dice & Coin",
  "version": "1.2.0",
  "category": "Games",
  "icon": "🎲",
  "color": "#CBA6F7",
  "desc": "d4–d20 dice roller with coin flips",
  "long": "A tabletop companion: roll any die from d4 to d20 (pips for the classics), flip a coin, or roll two and three dice at once with sums. Every result lands in the history strip so your table can audit your luck.",
  "changelog": "Multi-dice rolls and roll history",
  "developer": "Leonux Community",
  "permissions": [
    "Runs offline",
    "Sandboxed"
  ],
  "window": {
    "width": 420,
    "height": 620
  },
  "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Dice & Coin</title>\n<style>\n*{box-sizing:border-box;margin:0}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(165deg,#141220,#1d1a30 60%,#241f3d);color:#f0eefa;height:100vh;display:flex;flex-direction:column;overflow:hidden;user-select:none;padding:18px}\nh1{font-size:18px}\n.wrap{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px}\n.die{width:130px;height:130px;border-radius:24px;background:linear-gradient(160deg,#fbfbff,#d8d8ea);display:grid;place-items:center;font-size:64px;font-weight:800;color:#241f3d;box-shadow:0 14px 34px -10px rgba(0,0,0,.55), inset 0 -6px 0 rgba(0,0,0,.12);cursor:pointer;transition:transform .1s}\n.die:active{transform:scale(.94)}\n.die.roll{animation:tumble .5s ease}\n@keyframes tumble{0%{transform:rotate(0) scale(1)}30%{transform:rotate(-14deg) scale(1.08)}60%{transform:rotate(10deg) scale(.96)}100%{transform:rotate(0)}}\n.pips{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;width:74px;height:74px}\n.pips i{border-radius:50%;background:#241f3d;display:block;width:100%;height:100%;visibility:hidden}\n.pips i.on{visibility:visible}\n.row{display:flex;gap:8px;flex-wrap:wrap;justify-content:center}\n.chip{border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.06);color:#e8e4fa;border-radius:999px;padding:7px 14px;font-size:12.5px;font-weight:700;cursor:pointer}\n.chip.on{background:#CBA6F7;color:#1a1226;border-color:#CBA6F7}\n.result{font-size:15px;font-weight:700;color:#CBA6F7;min-height:22px;text-align:center}\n.hist{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;max-width:340px}\n.hist span{background:rgba(255,255,255,.07);border-radius:8px;padding:3px 9px;font-size:12px;font-weight:700}\n.hist span.h{color:#F6C177}.hist span.t{color:#4DD0E1}\n.mode{font-size:12px;color:#b6b0d4;margin-top:2px}\n</style></head><body>\n<h1>🎲 Dice & Coin</h1>\n<div class=\"wrap\">\n  <div class=\"die\" id=\"die\"><div class=\"pips\" id=\"pips\"></div></div>\n  <div class=\"result\" id=\"result\">Pick a die, then tap it</div>\n  <div class=\"row\" id=\"diceRow\"></div>\n  <div class=\"row\">\n    <div class=\"chip\" id=\"mCoin\">🪙 Coin flip</div>\n    <div class=\"chip\" id=\"roll2\">Roll ×2</div>\n    <div class=\"chip\" id=\"roll3\">Roll ×3</div>\n  </div>\n  <div class=\"mode\" id=\"mode\">Mode: single die · d6</div>\n  <div class=\"hist\" id=\"hist\"></div>\n</div>\n<script>\n'use strict';\nvar PIPS={1:[4],2:[0,8],3:[0,4,8],4:[0,2,6,8],5:[0,2,4,6,8],6:[0,2,3,5,6,8]};\nvar dice=[{n:'d4',s:4},{n:'d6',s:6},{n:'d8',s:8},{n:'d10',s:10},{n:'d12',s:12},{n:'d20',s:20}];\nvar sides=6,mode='single',hist=[],die=document.getElementById('die'),pips=document.getElementById('pips'),result=document.getElementById('result'),histEl=document.getElementById('hist'),modeEl=document.getElementById('mode');\nvar diceRow=document.getElementById('diceRow');\ndice.forEach(function(d){\n  var c=document.createElement('div');c.className='chip'+(d.s===6?' on':'');c.textContent=d.n;\n  c.onclick=function(){sides=d.s;mode='single';paintChips(d.s);modeEl.textContent='Mode: single die · '+d.n;\n    if(d.s<=6&&d.s!==3){showPips(roll(1)[0]);result.textContent='You rolled '+lastValue;}else{die.textContent=d.s===3?'⚂':String(roll(1)[0]);result.textContent='You rolled '+lastValue;}\n  };diceRow.appendChild(c);\n});\nvar lastValue=1;\nfunction roll(n){var out=[];for(var i=0;i<n;i++)out.push(1+Math.floor(Math.random()*sides));lastValue=out[0];return out;}\nfunction showPips(v){die.innerHTML='';var p=document.createElement('div');p.className='pips';\n  for(var i=0;i<9;i++){var dot=document.createElement('i');if(PIPS[v]&&PIPS[v].indexOf(i)>=0)dot.classList.add('on');p.appendChild(dot);}\n  die.appendChild(p);}\nfunction paintChips(s){Array.prototype.forEach.call(diceRow.children,function(c){c.classList.toggle('on',c.textContent==='d'+s);});}\nfunction doRoll(count){\n  count=count||1;\n  die.classList.remove('roll');void die.offsetWidth;die.classList.add('roll');\n  var vals=roll(count);\n  setTimeout(function(){\n    if(mode==='coin'){/*noop*/}\n    else if(sides<=6){showPips(vals[0]);}\n    else die.textContent=String(vals[0]);\n    if(count>1){result.textContent='Rolled: '+vals.join(' + ')+' = '+(vals.reduce(function(a,b){return a+b},0));}\n    else result.textContent=mode==='coin'?(vals[0]?'🪙 Heads!':'🪙 Tails!'):('You rolled '+vals[0]+' · '+sides+'-sided');\n    pushHist(mode==='coin'?(vals[0]?'H':'T'):vals.join(count>1?'+':''));\n  },260);\n}\nfunction doCoin(){\n  die.classList.remove('roll');void die.offsetWidth;die.classList.add('roll');\n  modeEl.textContent='Mode: coin flip';\n  setTimeout(function(){\n    var heads=Math.random()<0.5;\n    die.textContent=heads?'🪙':'coins';\n    die.style.fontSize='64px';\n    result.textContent=heads?'HEADS — lucky you!':'TAILS — the coin has spoken';\n    pushHist(heads?'H':'T');\n  },300);\n}\nfunction pushHist(v){\n  hist.unshift(v);if(hist.length>14)hist.pop();\n  histEl.innerHTML='';\n  hist.forEach(function(h){var s=document.createElement('span');if(h==='H')s.className='h';if(h==='T')s.className='t';s.textContent=h;histEl.appendChild(s);});\n}\ndocument.getElementById('mCoin').onclick=function(){paintChips(-1);this.classList.add('on');doCoin();};\ndocument.getElementById('roll2').onclick=function(){if(mode==='coin')return doRoll(1);doRoll(2);};\ndocument.getElementById('roll3').onclick=function(){if(mode==='coin')return doRoll(1);doRoll(3);};\nArray.prototype.forEach.call(diceRow.children,function(c){c.onclick=(function(orig){return function(){orig();document.getElementById('mCoin').classList.remove('on');mode='single';die.style.fontSize='';};})(c.onclick);});\nshowPips(5);result.textContent='Tap the die to roll';\ndie.onclick=function(){if(mode==='coin')doCoin();else doRoll(1);};\n</script></body></html>\n"
}