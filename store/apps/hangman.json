{
 "id": "hangman",
 "type": "app",
 "name": "Hangman",
 "version": "1.0.0",
 "category": "Games",
 "icon": "🪢",
 "color": "#f59e0b",
 "desc": "Guess the word before the gallows is complete",
 "long": "Four word categories, on-screen and physical keyboard input, streak tracking and a hand-drawn gallows.",
 "changelog": "First release",
 "developer": "Leonux Community",
 "permissions": [
  "Runs offline",
  "Sandboxed"
 ],
 "window": {
  "width": 460,
  "height": 580,
  "minWidth": 360,
  "minHeight": 500
 },
 "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Hangman</title><style>*{box-sizing:border-box;margin:0}\n:root{--bg:#10131c;--fg:#e8ecf6;--mut:#8b94ab;--ac:#7EE787;--line:rgba(255,255,255,.1);--card:rgba(255,255,255,.05)}\nhtml,body{height:100%}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(165deg,#10131c,#161a28);color:var(--fg);overflow:hidden;user-select:none;-webkit-user-select:none}\nbutton{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.08);border:1px solid var(--line);border-radius:9px;padding:7px 13px;cursor:pointer;transition:background .12s,transform .08s}\nbutton:hover{background:rgba(255,255,255,.15)}button:active{transform:scale(.96)}\nbutton.pri{background:var(--ac);color:#0b1020;border-color:transparent;font-weight:700}\ninput,select,textarea{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.07);border:1px solid var(--line);border-radius:8px;padding:6px 9px;outline:none;user-select:text;-webkit-user-select:text}\ninput:focus,select:focus,textarea:focus{border-color:var(--ac)}select option{background:#1b2030}\n.wrap{height:100%;display:flex;flex-direction:column;align-items:center;gap:10px;padding:14px;overflow:auto}\n.bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:center}\n.stat{font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:.06em;text-align:center}.stat b{display:block;color:var(--ac);font-size:20px;letter-spacing:0}\nh1{font-size:16px}h1 span{color:var(--ac)}\n.muted{color:var(--mut);font-size:12px}\ncanvas{display:block;max-width:100%}\nlabel{font-size:12px;color:var(--mut)}\n.word{font:700 30px ui-monospace,Menlo,monospace;letter-spacing:.35em;min-height:42px;text-align:center}\n.kb{display:grid;grid-template-columns:repeat(9,1fr);gap:5px;max-width:420px;width:100%}\n.kb button{padding:8px 0;font-weight:700}.kb button:disabled{opacity:.25;cursor:default}.kb .hit{background:#166534}.kb .miss{background:#7f1d1d}\n</style></head><body><div class=\"wrap\">\n<h1><span>Hangman</span></h1>\n<div class=\"bar\"><select id=\"cat\"><option>Animals</option><option>Tech</option><option>Countries</option><option>Food</option></select><button class=\"pri\" id=\"new\">New word</button></div>\n<canvas id=\"c\" width=\"220\" height=\"200\"></canvas>\n<div class=\"word\" id=\"w\"></div><div class=\"muted\" id=\"msg\"></div>\n<div class=\"kb\" id=\"kb\"></div>\n</div><script>\nconst WORDS={Animals:'elephant giraffe penguin dolphin kangaroo cheetah octopus flamingo hedgehog panther crocodile squirrel gorilla buffalo lobster'.split(' '),Tech:'keyboard internet algorithm browser database compiler network pixel kernel software firmware protocol bandwidth encryption variable'.split(' '),Countries:'brazil germany norway portugal vietnam argentina morocco thailand ireland australia colombia indonesia switzerland'.split(' '),Food:'spaghetti avocado pancake burrito dumpling croissant lasagna mushroom broccoli pretzel sandwich chocolate pineapple'.split(' ')};\nconst $=s=>document.querySelector(s),x=$('#c').getContext('2d');let word,got,miss,over,streak=0;\nfunction start(){const l=WORDS[$('#cat').value];word=l[Math.random()*l.length|0];got=new Set;miss=0;over=false;$('#msg').textContent='Streak: '+streak+' · 7 mistakes allowed';kb();draw()}\nfunction kb(){const k=$('#kb');k.innerHTML='';'abcdefghijklmnopqrstuvwxyz'.split('').forEach(ch=>{const b=document.createElement('button');b.textContent=ch.toUpperCase();b.id='k'+ch;b.onclick=()=>guess(ch);k.appendChild(b)})}\nfunction guess(ch){if(over||got.has(ch))return;got.add(ch);const b=$('#k'+ch);b.disabled=true;if(word.includes(ch))b.className='hit';else{b.className='miss';miss++}\n const solved=[...word].every(c=>got.has(c));if(solved){over=true;streak++;$('#msg').textContent='You got it! Streak: '+streak}else if(miss>=7){over=true;streak=0;$('#msg').textContent='Out of tries — it was '+word.toUpperCase()}draw()}\nfunction draw(){x.clearRect(0,0,220,200);x.strokeStyle='#8b94ab';x.lineWidth=4;x.lineCap='round';const L=(a,b,c,d)=>{x.beginPath();x.moveTo(a,b);x.lineTo(c,d);x.stroke()};\n L(20,190,120,190);L(50,190,50,15);L(50,15,140,15);L(140,15,140,40);\n x.strokeStyle='#7EE787';if(miss>0){x.beginPath();x.arc(140,55,15,0,7);x.stroke()}if(miss>1)L(140,70,140,125);if(miss>2)L(140,85,118,108);if(miss>3)L(140,85,162,108);if(miss>4)L(140,125,120,160);if(miss>5)L(140,125,160,160);\n if(miss>6){x.strokeStyle='#ef4444';L(133,50,139,56);L(139,50,133,56);L(143,50,149,56);L(149,50,143,56)}\n $('#w').textContent=[...word].map(c=>got.has(c)||over&&miss>=7?c.toUpperCase():'_').join(' ')}\ndocument.addEventListener('keydown',e=>{if(/^[a-z]$/i.test(e.key)&&!e.ctrlKey&&!e.metaKey&&document.activeElement.tagName!=='SELECT')guess(e.key.toLowerCase())});\n$('#new').onclick=start;$('#cat').onchange=start;start();\n</script></body></html>\n"
}