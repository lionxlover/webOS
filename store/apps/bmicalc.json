{
 "id": "bmicalc",
 "type": "app",
 "name": "BMI Calculator",
 "version": "1.0.0",
 "category": "Health",
 "icon": "⚖️",
 "color": "#4ade80",
 "desc": "Body-mass index with metric and imperial units",
 "long": "Enter height and weight in metric or imperial units and see your BMI, category, a colour scale and the healthy weight range.",
 "changelog": "First release",
 "developer": "Leonux Community",
 "permissions": [
  "Runs offline",
  "Sandboxed"
 ],
 "window": {
  "width": 440,
  "height": 560,
  "minWidth": 340,
  "minHeight": 480
 },
 "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>BMI Calculator</title><style>*{box-sizing:border-box;margin:0}\n:root{--bg:#10131c;--fg:#e8ecf6;--mut:#8b94ab;--ac:#7EE787;--line:rgba(255,255,255,.1);--card:rgba(255,255,255,.05)}\nhtml,body{height:100%}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(165deg,#10131c,#161a28);color:var(--fg);overflow:hidden;user-select:none;-webkit-user-select:none}\nbutton{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.08);border:1px solid var(--line);border-radius:9px;padding:7px 13px;cursor:pointer;transition:background .12s,transform .08s}\nbutton:hover{background:rgba(255,255,255,.15)}button:active{transform:scale(.96)}\nbutton.pri{background:var(--ac);color:#0b1020;border-color:transparent;font-weight:700}\ninput,select,textarea{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.07);border:1px solid var(--line);border-radius:8px;padding:6px 9px;outline:none;user-select:text;-webkit-user-select:text}\ninput:focus,select:focus,textarea:focus{border-color:var(--ac)}select option{background:#1b2030}\n.wrap{height:100%;display:flex;flex-direction:column;align-items:center;gap:10px;padding:14px;overflow:auto}\n.bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:center}\n.stat{font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:.06em;text-align:center}.stat b{display:block;color:var(--ac);font-size:20px;letter-spacing:0}\nh1{font-size:16px}h1 span{color:var(--ac)}\n.muted{color:var(--mut);font-size:12px}\ncanvas{display:block;max-width:100%}\nlabel{font-size:12px;color:var(--mut)}\n.wrap{justify-content:center}.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px;width:100%;max-width:400px;display:flex;flex-direction:column;gap:12px}\n.seg{display:flex;gap:6px}.seg button{flex:1}.seg .on{background:var(--ac);color:#0b1020;font-weight:700}\n.in{display:flex;gap:8px;align-items:center}.in input{flex:1;min-width:0}\n.scale{position:relative;height:14px;border-radius:7px;background:linear-gradient(90deg,#4f8cff 0 18%,#7EE787 18% 45%,#f5c542 45% 62%,#f97316 62% 80%,#ef4444 80%)}.scale i{position:absolute;top:-4px;width:4px;height:22px;background:#fff;border-radius:2px;transition:left .3s}\n#bmi{font-size:44px;font-weight:800;text-align:center;color:var(--ac)}#cat{text-align:center;font-size:14px}\n</style></head><body><div class=\"wrap\"><div class=\"card\">\n<h1>BMI <span>Calculator</span></h1>\n<div class=\"seg\"><button id=\"m\" class=\"on\">Metric</button><button id=\"i\">Imperial</button></div>\n<div class=\"in\"><label id=\"l1\" style=\"width:70px\">Height cm</label><input type=\"number\" id=\"h\" value=\"172\"><input type=\"number\" id=\"h2\" value=\"0\" style=\"display:none\"></div>\n<div class=\"in\"><label id=\"l2\" style=\"width:70px\">Weight kg</label><input type=\"number\" id=\"w\" value=\"68\"></div>\n<div id=\"bmi\">--</div><div id=\"cat\" class=\"muted\"></div><div class=\"scale\"><i id=\"pin\"></i></div>\n<div class=\"muted\" id=\"rng\"></div><div class=\"muted\">For adults only. BMI is a rough screening tool, not a diagnosis.</div>\n</div></div><script>\nconst $=s=>document.querySelector(s);let imp=false;\nfunction mode(v){imp=v;$('#m').className=v?'':'on';$('#i').className=v?'on':'';$('#l1').textContent=v?'Height ft / in':'Height cm';$('#l2').textContent=v?'Weight lb':'Weight kg';$('#h2').style.display=v?'':'none';\n if(v){$('#h').value=5;$('#h2').value=8;$('#w').value=150}else{$('#h').value=172;$('#w').value=68}calc()}\nfunction calc(){let h=+$('#h').value,w=+$('#w').value;if(imp){h=(h*12+(+$('#h2').value||0))*2.54;w*=0.45359237}\n if(h<=0||w<=0){$('#bmi').textContent='--';return}const m=h/100,b=w/(m*m);$('#bmi').textContent=b.toFixed(1);\n const c=b<18.5?'Underweight':b<25?'Healthy weight':b<30?'Overweight':'Obese';$('#cat').textContent=c;\n $('#pin').style.left=Math.max(0,Math.min(97,(b-12)/(40-12)*100))+'%';\n const lo=18.5*m*m,hi=24.9*m*m;$('#rng').textContent='Healthy range for your height: '+(imp?(lo/.45359237).toFixed(0)+'–'+(hi/.45359237).toFixed(0)+' lb':lo.toFixed(1)+'–'+hi.toFixed(1)+' kg')}\n$('#m').onclick=()=>mode(false);$('#i').onclick=()=>mode(true);['#h','#h2','#w'].forEach(s=>$(s).oninput=calc);calc();\n</script></body></html>\n"
}