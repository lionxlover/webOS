{
  "id": "simon",
  "type": "app",
  "name": "Simon Memory",
  "version": "1.2.0",
  "category": "Games",
  "icon": "🧠",
  "color": "#6EE7B7",
  "desc": "The classic four-tone memory game",
  "long": "Watch the pattern grow, then repeat it back. Each round adds a tone — how deep can your memory go? Synthesized tones, glowing pads and a round tracker keep your brain honest.",
  "changelog": "Round progress dots and best-round tracking",
  "developer": "Leonux Community",
  "permissions": [
    "Runs offline",
    "Sandboxed"
  ],
  "window": {
    "width": 420,
    "height": 600
  },
  "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Simon</title>\n<style>\n*{box-sizing:border-box;margin:0}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(170deg,#141118,#1a151f 55%,#211a26);color:#f3eef6;height:100vh;display:flex;flex-direction:column;overflow:hidden;user-select:none;padding:18px;align-items:center}\nh1{font-size:18px;align-self:flex-start}h1 span{color:#4DD0E1}\n.top{display:flex;gap:16px;margin:10px 0 16px;font-size:12px;color:#b9aec4;font-weight:700}\n.top b{color:#4DD0E1;font-size:17px;display:block;text-align:center}\n.board{position:relative;width:min(320px,80vw);aspect-ratio:1}\n.quad{position:absolute;width:47%;height:47%;border-radius:18px;cursor:pointer;opacity:.55;transition:opacity .1s,transform .08s;border:2px solid rgba(255,255,255,.08)}\n.quad:active{transform:scale(.96)}\n.q0{left:0;top:0;background:#9ECE6A}\n.q1{right:0;top:0;background:#F6C177}\n.q2{left:0;bottom:0;background:#5B9DFA}\n.q3{right:0;bottom:0;background:#F28B82}\n.quad.lit{opacity:1;box-shadow:0 0 26px rgba(255,255,255,.35), inset 0 0 20px rgba(255,255,255,.3)}\n.center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:38%;height:38%;border-radius:50%;background:#1a151f;border:4px solid #141118;display:grid;place-items:center;text-align:center;box-shadow:0 8px 24px rgba(0,0,0,.5);z-index:2;cursor:pointer}\n.center b{font-size:24px;display:block}\n.center small{font-size:9.5px;letter-spacing:.14em;color:#b9aec4;font-weight:800}\n.msg{margin-top:16px;font-size:13.5px;font-weight:700;min-height:20px}\n.tonebar{display:flex;gap:5px;margin-top:10px}\n.tonebar i{width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,.12)}\n.tonebar i.on{background:#4DD0E1}\n</style></head><body>\n<h1>🧠 Simon <span>Memory</span></h1>\n<div class=\"top\"><div>ROUND<b id=\"round\">—</b></div><div>BEST<b id=\"best\">—</b></div><div>STATUS<b id=\"stat\" style=\"font-size:12px;padding-top:5px\">ready</b></div></div>\n<div class=\"board\">\n  <div class=\"quad q0\" data-q=\"0\"></div><div class=\"quad q1\" data-q=\"1\"></div>\n  <div class=\"quad q2\" data-q=\"2\"></div><div class=\"quad q3\" data-q=\"3\"></div>\n  <div class=\"center\" id=\"start\"><div><b id=\"cnum\">▶</b><small>SIMON</small></div></div>\n</div>\n<div class=\"tonebar\" id=\"tonebar\"></div>\n<div class=\"msg\" id=\"msg\">Watch the pattern, then repeat it</div>\n<script>\n'use strict';\nvar FREQ=[329.63,415.3,493.88,587.33];\nvar quads=document.querySelectorAll('.quad'),seq=[],pos=0,playing=false,accepting=false,best=0;\nvar ac=null;\nfunction ctx(){if(!ac)ac=new (window.AudioContext||window.webkitAudioContext)();if(ac.state==='suspended')ac.resume();return ac;}\nfunction tone(i,dur){\n  var c=ctx(),o=c.createOscillator(),g=c.createGain(),t=c.currentTime;\n  o.type='sine';o.frequency.value=FREQ[i];\n  g.gain.setValueAtTime(0.35,t);g.gain.exponentialRampToValueAtTime(0.0001,t+(dur||0.34));\n  o.connect(g);g.connect(c.destination);o.start(t);o.stop(t+(dur||0.34)+0.05);\n  quads[i].classList.add('lit');\n  setTimeout(function(){quads[i].classList.remove('lit');},(dur||0.34)*1000*0.8);\n}\nvar bar=document.getElementById('tonebar');\nfor(var k=0;k<20;k++)bar.appendChild(document.createElement('i'));\nfunction paintBar(){\n  var dots=bar.children;\n  for(var i=0;i<dots.length;i++)dots[i].className=i<seq.length?'on':'';\n}\nasync function playSeq(){\n  accepting=false;\n  document.getElementById('stat').textContent='watch';\n  for(var i=0;i<seq.length;i++){\n    await new Promise(function(r){setTimeout(r,i?320:520);});\n    tone(seq[i]);\n  }\n  accepting=true;pos=0;\n  document.getElementById('stat').textContent='repeat';\n  paintBar();\n}\nasync function start(){\n  if(playing)return;\n  playing=true;seq=[];document.getElementById('cnum').textContent='…';\n  document.getElementById('round').textContent='1';\n  next();\n}\nfunction next(){\n  seq.push(Math.floor(Math.random()*4));\n  document.getElementById('round').textContent=seq.length;\n  document.getElementById('cnum').textContent=seq.length;\n  playSeq();\n}\nquads.forEach(function(q){\n  q.addEventListener('pointerdown',function(){\n    if(!accepting)return;\n    var i=+q.dataset.q;\n    tone(i,0.22);\n    if(i===seq[pos]){\n      pos++;\n      paintBar();\n      if(pos>=seq.length){\n        accepting=false;\n        document.getElementById('msg').textContent='✓ Round '+seq.length+' cleared!';\n        document.getElementById('stat').textContent='nice';\n        if(seq.length>best){best=seq.length;document.getElementById('best').textContent=best;}\n        setTimeout(next,800);\n      }\n    }else{\n      accepting=false;playing=false;\n      tone(seq[pos],0.6);\n      document.getElementById('msg').textContent='✗ Wrong pad — you reached round '+seq.length+'. Tap the center to try again.';\n      document.getElementById('stat').textContent='game over';\n      document.getElementById('cnum').textContent='▶';\n      seq=[];paintBar();\n    }\n  });\n});\ndocument.getElementById('start').onclick=start;\npaintBar();\n</script></body></html>\n"
}