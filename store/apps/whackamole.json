{
  "id": "whackamole",
  "type": "app",
  "name": "Whack-a-Mole",
  "version": "1.2.0",
  "category": "Games",
  "icon": "🔨",
  "color": "#9ECE6A",
  "desc": "30 seconds of pure mole-smashing arcade",
  "long": "Moles pop from nine burrows and you have 30 seconds to smash as many as possible. Build combos, watch for bonus rabbits worth 5 points, and chase your session best as the pace ramps up.",
  "changelog": "Bonus rabbits and combo scoring",
  "developer": "Leonux Community",
  "permissions": [
    "Runs offline",
    "Sandboxed"
  ],
  "window": {
    "width": 420,
    "height": 600
  },
  "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Whack-a-Mole</title>\n<style>\n*{box-sizing:border-box;margin:0}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(170deg,#101a10,#152415 55%,#1a2f1c);color:#eafbef;height:100vh;display:flex;flex-direction:column;overflow:hidden;user-select:none;padding:18px}\nh1{font-size:18px}h1 span{color:#9ECE6A}\n.top{display:flex;align-items:baseline;gap:16px;margin:10px 0 14px;font-size:13px}\n.top b{font-size:22px;color:#9ECE6A}\n.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;max-width:380px;width:100%;aspect-ratio:1;margin:0 auto}\n.hole{border-radius:50%;background:radial-gradient(circle at 50% 38%,#0a140b,#060c07 70%);border:2px solid #263c28;display:grid;place-items:center;font-size:44px;cursor:pointer;transition:transform .08s;position:relative;overflow:hidden}\n.hole:active{transform:scale(.95)}\n.hole.up .mole{transform:translateY(0)}\n.mole{transform:translateY(120%);transition:transform .14s cubic-bezier(.2,.9,.3,1.2);filter:drop-shadow(0 4px 6px rgba(0,0,0,.5))}\n.hole.hit{background:radial-gradient(circle at 50% 38%,#24401f,#0a140b 70%)}\n.btn{border:0;border-radius:12px;padding:11px 20px;font-weight:800;font-size:14px;cursor:pointer;background:#9ECE6A;color:#0a140b;align-self:center;margin-top:14px}\n.btn:active{transform:scale(.97)}\n.msg{text-align:center;font-size:15px;font-weight:700;margin-top:12px;min-height:20px}\n.best{text-align:center;font-size:11.5px;color:#9db5a0;margin-top:4px}\n.hint{position:absolute;inset:0;display:grid;place-items:center;background:rgba(6,12,7,.72);border-radius:50%;font-size:11px;color:#9db5a0;padding:8px;text-align:center;pointer-events:none;opacity:1;transition:opacity .3s}\n.grid.playing .hint{opacity:0}\n</style></head><body>\n<h1>🔨 Whack-a-<span>Mole</span></h1>\n<div class=\"top\"><div>Score <b id=\"score\">0</b></div><div>Time <b id=\"time\">30</b>s</div><div>Combo <b id=\"combo\">×0</b></div></div>\n<div class=\"grid\" id=\"grid\"></div>\n<button class=\"btn\" id=\"go\">START · 30 seconds</button>\n<div class=\"msg\" id=\"msg\"></div>\n<div class=\"best\" id=\"best\"></div>\n<script>\n'use strict';\nvar grid=document.getElementById('grid'),scoreEl=document.getElementById('score'),timeEl=document.getElementById('time'),comboEl=document.getElementById('combo'),msgEl=document.getElementById('msg'),bestEl=document.getElementById('best'),goBtn=document.getElementById('go');\nvar running=false,score,combo,best=0,left,timer,spawnT;\nvar MOLES=['🦔','🐹','🐭','🦔','🐰','🦫']; // rabbit = bonus\nfor(var i=0;i<9;i++){(function(i){\n  var h=document.createElement('div');h.className='hole';\n  h.innerHTML='<span class=\"mole\"></span><span class=\"hint\">tap when<br>a mole<br>pops up</span>';\n  h.addEventListener('pointerdown',function(){hit(i,h)});\n  grid.appendChild(h);\n})(i);}\nvar holes=grid.children,up={};\nfunction start(){\n  running=true;score=0;combo=0;left=30;up={};\n  goBtn.style.visibility='hidden';grid.classList.add('playing');\n  paint();msgEl.textContent='Go! 🏎️';\n  timer=setInterval(function(){\n    left--;paint();\n    if(left<=0)finish();\n  },1000);\n  loop();\n}\nfunction loop(){\n  if(!running)return;\n  var delay=Math.max(380,900-left*18);\n  spawnT=setTimeout(function(){\n    if(!running)return;\n    var free=[];for(var i=0;i<9;i++)if(!up[i])free.push(i);\n    if(free.length){\n      var i=free[Math.floor(Math.random()*free.length)];\n      var bonus=Math.random()<0.14;\n      up[i]={bonus:bonus,el:holes[i]};\n      holes[i].querySelector('.mole').textContent=bonus?'🐰':MOLES[Math.floor(Math.random()*MOLES.length)];\n      holes[i].classList.add('up');\n      (function(i){setTimeout(function(){\n        if(up[i]&&running){holes[i].classList.remove('up');delete up[i];}\n      },700+Math.random()*500);})(i);\n    }\n    loop();\n  },delay);\n}\nfunction hit(i,h){\n  if(!running||!up[i])return;\n  var bonus=up[i].bonus;delete up[i];\n  h.classList.remove('up');h.classList.add('hit');setTimeout(function(){h.classList.remove('hit')},160);\n  combo++;score+=bonus?5:1;\n  paint();\n}\nfunction finish(){\n  running=false;clearTimeout(spawnT);clearInterval(timer);\n  for(var i=0;i<9;i++)holes[i].classList.remove('up');\n  up={};grid.classList.remove('playing');\n  if(score>best)best=score;\n  msgEl.textContent='⏱ Time! You scored '+score+' points.';\n  bestEl.textContent='Session best: '+best+' · tap START to play again';\n  goBtn.style.visibility='visible';goBtn.textContent='PLAY AGAIN';\n}\nfunction paint(){scoreEl.textContent=score;timeEl.textContent=left;comboEl.textContent='×'+combo;}\ngoBtn.onclick=start;\nbestEl.textContent='Smash every mole · 🐰 rabbits are worth 5';\n</script></body></html>\n"
}