{
  "id": "drumpads",
  "type": "app",
  "name": "Drum Pads",
  "version": "1.2.0",
  "category": "Media",
  "icon": "🥁",
  "color": "#F28B82",
  "desc": "12 synthesized drum pads with keyboard mapping",
  "long": "A 12-pad drum machine synthesized entirely with Web Audio — kicks, snares, hats, toms, crash, cowbell and even a laser. Tap the pads or use the on-pad keyboard keys and start making beats in seconds.",
  "changelog": "New laser pad and velocity tuning",
  "developer": "Leonux Community",
  "permissions": [
    "Runs offline",
    "Sandboxed"
  ],
  "window": {
    "width": 520,
    "height": 480
  },
  "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Drum Pads</title>\n<style>\n*{box-sizing:border-box;margin:0}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(170deg,#1c1210,#241612 55%,#2d1c16);color:#f8efe9;height:100vh;display:flex;flex-direction:column;overflow:hidden;user-select:none;padding:14px}\nh1{font-size:17px}h1 span{color:#FF8A65}\n.sub{font-size:11.5px;color:#c4a99c;margin:4px 0 12px}\n.grid{flex:1;display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:repeat(3,1fr);gap:10px}\n.pad{border-radius:16px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;cursor:pointer;transition:transform .06s,background .12s;position:relative;overflow:hidden}\n.pad:active,.pad.dn{transform:scale(.95);background:rgba(255,138,101,.2);border-color:#FF8A65}\n.pad b{font-size:15px}\n.pad small{font-size:10px;color:#b39a8e;font-weight:700}\n.pad .kb{position:absolute;top:7px;right:9px;font-size:9.5px;background:rgba(0,0,0,.35);border-radius:5px;padding:1px 6px;color:#f8efe9;font-weight:800}\n.pad.kick{background:linear-gradient(160deg,rgba(255,138,101,.16),rgba(255,138,101,.05))}\n.rec{position:fixed;right:16px;bottom:14px;display:flex;gap:8px;align-items:center;font-size:11px;color:#c4a99c}\n.dot{width:9px;height:9px;border-radius:50%;background:#FF8A65;animation:blink 1s infinite}\n@keyframes blink{50%{opacity:.2}}\n</style></head><body>\n<h1>🥁 Drum <span>Pads</span></h1>\n<div class=\"sub\">Tap pads or hit the keyboard keys · 12 synthesized drum voices, zero samples needed</div>\n<div class=\"grid\" id=\"grid\"></div>\n<div class=\"rec\" id=\"rec\"><span class=\"dot\"></span> Web Audio synthesis engine live</div>\n<script>\n'use strict';\nvar ac=null;\nfunction ctx(){if(!ac)ac=new (window.AudioContext||window.webkitAudioContext)();if(ac.state==='suspended')ac.resume();return ac;}\nfunction tone(f,dur,type,vol,slide){\n  var c=ctx(),o=c.createOscillator(),g=c.createGain(),t=c.currentTime;\n  o.type=type||'sine';o.frequency.setValueAtTime(f,t);\n  if(slide)o.frequency.exponentialRampToValueAtTime(Math.max(20,slide),t+dur);\n  g.gain.setValueAtTime(vol||0.4,t);g.gain.exponentialRampToValueAtTime(0.0001,t+dur);\n  o.connect(g);g.connect(c.destination);o.start(t);o.stop(t+dur+0.02);\n}\nfunction noise(dur,vol,hp){\n  var c=ctx(),len=Math.floor(c.sampleRate*dur),buf=c.createBuffer(1,len,c.sampleRate),d=buf.getChannelData(0);\n  for(var i=0;i<len;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/len,2);\n  var s=c.createBufferSource(),g=c.createGain(),f=c.createBiquadFilter();\n  f.type=hp?'highpass':'lowpass';f.frequency.value=hp||7000;\n  s.buffer=buf;g.gain.value=vol||0.4;\n  s.connect(f);f.connect(g);g.connect(c.destination);s.start();\n}\nfunction kick(){tone(150,0.4,'sine',0.9,40);noise(0.03,0.15);}\nfunction snare(){noise(0.16,0.5,1800);tone(190,0.09,'triangle',0.3,120);}\nfunction hat(){noise(0.05,0.28,8000);}\nfunction openhat(){noise(0.3,0.22,7000);}\nfunction clap(){for(var i=0;i<3;i++)setTimeout(function(){noise(0.1,0.3,1500);},i*22);}\nfunction tomL(){tone(180,0.28,'sine',0.6,80);}\nfunction tomH(){tone(260,0.24,'sine',0.55,120);}\nfunction crash(){noise(0.7,0.3,5000);}\nfunction ride(){noise(0.4,0.18,9000);}\nfunction cowbell(){tone(540,0.18,'square',0.16);tone(800,0.18,'square',0.12);}\nfunction laser(){tone(900,0.22,'sawtooth',0.3,120);}\nvar PADS=[\n  ['Kick','drum','1',kick],['Snare','drum','2',snare],['Hi-hat','cym','3',hat],['Open hat','cym','4',openhat],\n  ['Clap','perc','q',clap],['Tom lo','drum','w',tomL],['Tom hi','drum','e',tomH],['Rim','perc','r',function(){tone(1700,0.03,'square',0.2);}],\n  ['Crash','cym','a',crash],['Ride','cym','s',ride],['Cowbell','perc','d',cowbell],['Laser','fx','f',laser]\n];\nvar grid=document.getElementById('grid'),KEYS={};\nPADS.forEach(function(p){\n  var el=document.createElement('div');el.className='pad'+(p[0]==='Kick'?' kick':'');\n  el.innerHTML='<span class=\"kb\">'+p[2].toUpperCase()+'</span><b>'+p[0]+'</b><small>'+p[1]+'</small>';\n  el.addEventListener('pointerdown',function(e){e.preventDefault();p[3]();});\n  grid.appendChild(el);KEYS[p[2]]=el;\n});\ndocument.addEventListener('keydown',function(e){\n  var k=e.key.toLowerCase();if(e.repeat)return;\n  if(KEYS[k]){KEYS[k].classList.add('dn');PADS.find(function(p){return p[2]===k;})[3]();}\n});\ndocument.addEventListener('keyup',function(e){var k=e.key.toLowerCase();if(KEYS[k])KEYS[k].classList.remove('dn');});\n</script></body></html>\n"
}