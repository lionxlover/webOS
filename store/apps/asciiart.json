{
 "id": "asciiart",
 "type": "app",
 "name": "ASCII Art",
 "version": "1.0.0",
 "category": "Media",
 "icon": "🔤",
 "color": "#a3e635",
 "desc": "Turn images and text into ASCII art",
 "long": "Drop in a picture to convert it into characters, or render big block text. Adjust width, invert shades and copy the result.",
 "changelog": "First release",
 "developer": "Leonux Community",
 "permissions": [
  "Runs offline",
  "Sandboxed"
 ],
 "window": {
  "width": 620,
  "height": 560,
  "minWidth": 400,
  "minHeight": 380
 },
 "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>ASCII Art</title><style>*{box-sizing:border-box;margin:0}\n:root{--bg:#10131c;--fg:#e8ecf6;--mut:#8b94ab;--ac:#7EE787;--line:rgba(255,255,255,.1);--card:rgba(255,255,255,.05)}\nhtml,body{height:100%}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(165deg,#10131c,#161a28);color:var(--fg);overflow:hidden;user-select:none;-webkit-user-select:none}\nbutton{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.08);border:1px solid var(--line);border-radius:9px;padding:7px 13px;cursor:pointer;transition:background .12s,transform .08s}\nbutton:hover{background:rgba(255,255,255,.15)}button:active{transform:scale(.96)}\nbutton.pri{background:var(--ac);color:#0b1020;border-color:transparent;font-weight:700}\ninput,select,textarea{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.07);border:1px solid var(--line);border-radius:8px;padding:6px 9px;outline:none;user-select:text;-webkit-user-select:text}\ninput:focus,select:focus,textarea:focus{border-color:var(--ac)}select option{background:#1b2030}\n.wrap{height:100%;display:flex;flex-direction:column;align-items:center;gap:10px;padding:14px;overflow:auto}\n.bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:center}\n.stat{font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:.06em;text-align:center}.stat b{display:block;color:var(--ac);font-size:20px;letter-spacing:0}\nh1{font-size:16px}h1 span{color:var(--ac)}\n.muted{color:var(--mut);font-size:12px}\ncanvas{display:block;max-width:100%}\nlabel{font-size:12px;color:var(--mut)}\n.wrap{align-items:stretch}pre{background:#05070d;border:1px solid var(--line);border-radius:10px;padding:10px;font:7px/7px ui-monospace,Menlo,monospace;color:#7EE787;overflow:auto;flex:1;min-height:120px;user-select:text;-webkit-user-select:text;white-space:pre}\n.tabs{display:flex;gap:6px}.tabs .on{background:var(--ac);color:#0b1020}\n</style></head><body><div class=\"wrap\">\n<h1>ASCII <span>Art</span></h1>\n<div class=\"tabs\"><button id=\"t1\" class=\"on\">From image</button><button id=\"t2\">Big text</button></div>\n<div class=\"bar\" id=\"p1\"><input type=\"file\" id=\"f\" accept=\"image/*\"><label>Width <input type=\"range\" id=\"w\" min=\"30\" max=\"160\" value=\"90\"></label><label><input type=\"checkbox\" id=\"inv\"> Invert</label></div>\n<div class=\"bar\" id=\"p2\" style=\"display:none\"><input id=\"tx\" value=\"LEONUX\" maxlength=\"14\" style=\"width:180px\"></div>\n<pre id=\"o\">Pick an image (or drop one onto the app) to turn it into text.</pre>\n<div class=\"bar\"><button class=\"pri\" id=\"cp\">Copy</button><span class=\"muted\" id=\"m\"></span></div>\n</div><script>\nconst $=s=>document.querySelector(s),R=' .:-=+*#%@';let img=null,mode=1;\nfunction conv(){if(!img)return;const w=+$('#w').value,h=Math.round(w*img.height/img.width*.5),c=document.createElement('canvas');c.width=w;c.height=h;const g=c.getContext('2d');g.fillStyle='#fff';g.fillRect(0,0,w,h);g.drawImage(img,0,0,w,h);\n const d=g.getImageData(0,0,w,h).data;let s='';for(let y=0;y<h;y++){for(let i=0;i<w;i++){const k=(y*w+i)*4;let l=(d[k]*.3+d[k+1]*.59+d[k+2]*.11)/255;if(!$('#inv').checked)l=1-l;s+=R[Math.min(R.length-1,l*R.length|0)]}s+='\\n'}\n $('#o').style.fontSize='7px';$('#o').textContent=s;$('#m').textContent=w+' x '+h+' chars'}\nfunction load(file){if(!file)return;const u=URL.createObjectURL(file),i=new Image();i.onload=()=>{img=i;conv()};i.src=u}\n$('#f').onchange=e=>load(e.target.files[0]);addEventListener('dragover',e=>e.preventDefault());addEventListener('drop',e=>{e.preventDefault();load(e.dataTransfer.files[0])});\n$('#w').oninput=conv;$('#inv').onchange=conv;\n// big text: render with canvas and threshold\nfunction big(){const t=$('#tx').value||' ',c=document.createElement('canvas'),g=c.getContext('2d');g.font='bold 22px monospace';const w=Math.ceil(g.measureText(t).width)+4;c.width=w;c.height=26;g.font='bold 22px monospace';g.fillStyle='#000';g.fillRect(0,0,w,26);g.fillStyle='#fff';g.fillText(t,2,21);\n const d=g.getImageData(0,0,w,26).data;let s='';for(let y=0;y<26;y+=2){for(let i=0;i<w;i++){const a=d[(y*w+i)*4],b=d[((y+1)*w+i)*4];s+=a>100&&b>100?'█':a>100?'▀':b>100?'▄':' '}s+='\\n'}$('#o').style.fontSize='12px';$('#o').textContent=s;$('#m').textContent=''}\nfunction tab(n){mode=n;$('#t1').className=n==1?'on':'';$('#t2').className=n==2?'on':'';$('#p1').style.display=n==1?'':'none';$('#p2').style.display=n==2?'':'none';n==1?(img?conv():$('#o').textContent='Pick an image (or drop one onto the app).'):big()}\n$('#t1').onclick=()=>tab(1);$('#t2').onclick=()=>tab(2);$('#tx').oninput=big;\n$('#cp').onclick=()=>{const t=$('#o').textContent;navigator.clipboard?navigator.clipboard.writeText(t).then(()=>$('#m').textContent='Copied',()=>getSelection().selectAllChildren($('#o'))):getSelection().selectAllChildren($('#o'))};\n</script></body></html>\n"
}