{
  "id": "wordscramble",
  "type": "app",
  "name": "Word Scramble",
  "version": "1.2.0",
  "category": "Games",
  "icon": "🔤",
  "color": "#7EE787",
  "desc": "Unscramble tech words against the clock",
  "long": "A word puzzle with a Leonux flavour: every round scrambles a tech word (with a topical hint), gives you 30 seconds, and rewards streaks with compounding points. Buy a letter hint for 3 points if you get stuck.",
  "changelog": "Streak bonuses and letter hints",
  "developer": "Leonux Community",
  "permissions": [
    "Runs offline",
    "Sandboxed"
  ],
  "window": {
    "width": 420,
    "height": 580
  },
  "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Word Scramble</title>\n<style>\n*{box-sizing:border-box;margin:0}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(170deg,#101c17,#13251d 55%,#173024);color:#e9f6ee;height:100vh;display:flex;flex-direction:column;overflow:hidden;user-select:none;padding:18px;align-items:center}\nh1{font-size:18px;align-self:flex-start}h1 span{color:#7EE787}\n.top{display:flex;gap:14px;font-size:12.5px;margin:8px 0 18px;color:#a9c4b3;font-weight:700}\n.top b{color:#7EE787;font-size:16px}\n.scram{font-size:36px;font-weight:800;letter-spacing:.28em;text-align:center;margin:6px 0 4px;font-family:ui-monospace,Menlo,monospace}\n.hint{font-size:12.5px;color:#a9c4b3;margin-bottom:16px}\ninput{width:min(320px,86vw);background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:12px;padding:13px 16px;color:#e9f6ee;font-size:16px;text-align:center;outline:none;font-weight:600}\ninput:focus{border-color:#7EE787}\n.row{display:flex;gap:8px;margin-top:16px}\n.btn{border:0;border-radius:11px;padding:11px 18px;font-weight:800;font-size:13px;cursor:pointer}\n.btn.g{background:rgba(255,255,255,.08);color:#e9f6ee}\n.btn.p{background:#7EE787;color:#0a1a10}\n.btn:active{transform:scale(.97)}\n.msg{margin-top:14px;font-size:14px;font-weight:700;min-height:20px;text-align:center}\n.timer{width:min(320px,86vw);height:7px;background:rgba(255,255,255,.09);border-radius:4px;margin-top:16px;overflow:hidden}\n.timer i{display:block;height:100%;background:#7EE787;width:100%;transition:width .95s linear;border-radius:4px}\n.streak{font-size:11.5px;color:#a9c4b3;margin-top:8px}\n</style></head><body>\n<h1>🔤 Word <span>Scramble</span></h1>\n<div class=\"top\"><div>Round <b id=\"round\">1</b></div><div>Score <b id=\"score\">0</b></div><div>Streak <b id=\"streak\">0</b>🔥</div></div>\n<div class=\"scram\" id=\"scram\">—</div>\n<div class=\"hint\" id=\"hint\">Unscramble the word · 30 seconds each</div>\n<input id=\"in\" placeholder=\"type your answer…\" autocomplete=\"off\" spellcheck=\"false\">\n<div class=\"row\">\n  <button class=\"btn g\" id=\"skip\">Skip ⏭</button>\n  <button class=\"btn g\" id=\"giveup\">Hint 💡</button>\n  <button class=\"btn p\" id=\"check\">Check ✓</button>\n</div>\n<div class=\"timer\"><i id=\"tbar\"></i></div>\n<div class=\"msg\" id=\"msg\"></div>\n<div class=\"streak\" id=\"streakTxt\">Enter submits automatically when the word is right</div>\n<script>\n'use strict';\nvar WORDS=[['leonux','A desktop OS in your browser'],['browser','Chrome, Firefox, Safari…'],['safari','It browses, but it is a journey'],['widget','Small tool on your desktop'],['theme','A look for your system'],['sound','What your ears detect'],['music','Organized sound'],['pixel','Smallest picture element'],['cache','Storage close to hand'],['cloud','Where files float'],['token','A small key'],['matrix','Green falling code'],['nebula','A stellar nursery'],['comet','Icy visitor with a tail'],['quasar','A very bright heart'],['zenith','The highest point'],['kernel','The OS core'],['packet','Data in the post'],['socket','Where connections plug in'],['vector','Magnitude and direction'],['lambda','The anonymous function'],['binary','Zeros and ones'],['server','It serves you pages'],['cursor','It blinks while you think'],['trackpad','Finger-driven pointer'],['dockbar','Where shortcuts live'],['launchpad','Rockets and apps start here'],['spotlight','Search that shines']];\nvar word,answer,topic,timeLeft,timer,score=0,streak=0,round=1;\nvar inEl=document.getElementById('in'),msgEl=document.getElementById('msg');\nfunction shuffle(s){var a=s.split('');for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t;}return a.join('');}\nfunction next(){\n  var pick=WORDS[Math.floor(Math.random()*WORDS.length)];\n  answer=pick[0];topic=pick[1];\n  var s=shuffle(answer);\n  if(s===answer)s=shuffle(answer);\n  word=s;\n  document.getElementById('scram').textContent=word.toUpperCase().split('').join(' ');\n  document.getElementById('hint').textContent='Hint: '+topic;\n  inEl.value='';msgEl.textContent='';\n  timeLeft=30;bar();clearInterval(timer);\n  timer=setInterval(function(){\n    timeLeft-=1;bar();\n    if(timeLeft<=0){clearInterval(timer);lose('⏱ Time up! It was “'+answer+'”');}\n  },1000);\n  inEl.focus();\n}\nfunction bar(){document.getElementById('tbar').style.width=Math.max(0,timeLeft/30*100)+'%';}\nfunction check(){\n  if(inEl.value.trim().toLowerCase()===answer){\n    clearInterval(timer);\n    score+=10+streak*2;streak++;round++;\n    document.getElementById('score').textContent=score;\n    document.getElementById('streak').textContent=streak;\n    document.getElementById('round').textContent=round;\n    msgEl.textContent='✓ Correct! +'+(10+streak*2)+' points';\n    setTimeout(next,900);\n  }else{\n    lose('✗ Not quite — try again!');\n  }\n}\nfunction lose(t){msgEl.textContent=t;streak=0;document.getElementById('streak').textContent=0;}\ndocument.getElementById('check').onclick=check;\ndocument.getElementById('skip').onclick=function(){clearInterval(timer);lose('Skipped — it was “'+answer+'”');round++;document.getElementById('round').textContent=round;setTimeout(next,800);};\ndocument.getElementById('giveup').onclick=function(){\n  var revealed=answer[0]+'·'.repeat(Math.max(0,answer.length-2))+answer[answer.length-1];\n  document.getElementById('hint').textContent='Hint: '+topic+' · looks like “'+revealed+'”';\n  score=Math.max(0,score-3);document.getElementById('score').textContent=score;\n};\ninEl.addEventListener('keydown',function(e){if(e.key==='Enter')check();});\nnext();\n</script></body></html>\n"
}