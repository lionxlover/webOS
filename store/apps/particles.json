{
 "id": "particles",
 "type": "app",
 "name": "Particle Toy",
 "version": "1.0.0",
 "category": "Media",
 "icon": "✨",
 "color": "#f472b6",
 "desc": "Thousands of particles that follow your pointer",
 "long": "Attract, repel, swirl or burst up to 1,500 colourful particles with the mouse or touch. Toggle motion trails and watch the patterns.",
 "changelog": "First release",
 "developer": "Leonux Community",
 "permissions": [
  "Runs offline",
  "Sandboxed"
 ],
 "window": {
  "width": 620,
  "height": 500,
  "minWidth": 360,
  "minHeight": 320
 },
 "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Particle Toy</title><style>*{box-sizing:border-box;margin:0}\n:root{--bg:#10131c;--fg:#e8ecf6;--mut:#8b94ab;--ac:#7EE787;--line:rgba(255,255,255,.1);--card:rgba(255,255,255,.05)}\nhtml,body{height:100%}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(165deg,#10131c,#161a28);color:var(--fg);overflow:hidden;user-select:none;-webkit-user-select:none}\nbutton{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.08);border:1px solid var(--line);border-radius:9px;padding:7px 13px;cursor:pointer;transition:background .12s,transform .08s}\nbutton:hover{background:rgba(255,255,255,.15)}button:active{transform:scale(.96)}\nbutton.pri{background:var(--ac);color:#0b1020;border-color:transparent;font-weight:700}\ninput,select,textarea{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.07);border:1px solid var(--line);border-radius:8px;padding:6px 9px;outline:none;user-select:text;-webkit-user-select:text}\ninput:focus,select:focus,textarea:focus{border-color:var(--ac)}select option{background:#1b2030}\n.wrap{height:100%;display:flex;flex-direction:column;align-items:center;gap:10px;padding:14px;overflow:auto}\n.bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:center}\n.stat{font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:.06em;text-align:center}.stat b{display:block;color:var(--ac);font-size:20px;letter-spacing:0}\nh1{font-size:16px}h1 span{color:var(--ac)}\n.muted{color:var(--mut);font-size:12px}\ncanvas{display:block;max-width:100%}\nlabel{font-size:12px;color:var(--mut)}\n.wrap{padding:0;gap:0}canvas{width:100%;flex:1;min-height:0;background:#05070d;cursor:crosshair;touch-action:none}\n.ctl{display:flex;gap:10px;align-items:center;justify-content:center;padding:8px;flex-wrap:wrap}\n</style></head><body><div class=\"wrap\"><canvas id=\"c\"></canvas>\n<div class=\"ctl\"><select id=\"md\"><option value=\"attract\">Attract</option><option value=\"repel\">Repel</option><option value=\"swirl\">Swirl</option><option value=\"fireworks\">Burst</option></select><label>Count <input id=\"n\" type=\"range\" min=\"100\" max=\"1500\" step=\"50\" value=\"600\"></label><label><input id=\"tr\" type=\"checkbox\" checked> Trails</label><button id=\"rs\">Reset</button></div></div><script>\nconst cv=document.getElementById('c'),x=cv.getContext('2d'),$=s=>document.querySelector(s);let W,H,P=[],m={x:-999,y:-999,d:false};\nfunction fit(){const r=cv.getBoundingClientRect();W=cv.width=r.width;H=cv.height=r.height}addEventListener('resize',fit);fit();\nfunction spawn(){const n=+$('#n').value;while(P.length<n)P.push({x:Math.random()*W,y:Math.random()*H,vx:0,vy:0,h:Math.random()*360});P.length=n}\nfunction pos(e){const r=cv.getBoundingClientRect();m.x=e.clientX-r.left;m.y=e.clientY-r.top}\ncv.onpointermove=pos;cv.onpointerdown=e=>{pos(e);m.d=true;if($('#md').value=='fireworks')burst()};cv.onpointerup=cv.onpointerleave=()=>{m.d=false;if(!m.d)m.x=m.y=-999};\nfunction burst(){P.forEach(p=>{const a=Math.atan2(p.y-m.y,p.x-m.x),s=2+Math.random()*9;p.vx+=Math.cos(a)*s;p.vy+=Math.sin(a)*s})}\nfunction step(){spawn();x.fillStyle=$('#tr').checked?'rgba(5,7,13,.18)':'#05070d';x.fillRect(0,0,W,H);const md=$('#md').value;\n for(const p of P){const dx=m.x-p.x,dy=m.y-p.y,d=Math.hypot(dx,dy)+.1;\n  if(m.x>-900&&md!='fireworks'){const f=Math.min(1.5,260/(d*d/12+20))*.6;\n   if(md=='attract'){p.vx+=dx/d*f;p.vy+=dy/d*f}else if(md=='repel'){p.vx-=dx/d*f*2;p.vy-=dy/d*f*2}else{p.vx+=(dx/d+(-dy/d))*f;p.vy+=(dy/d+dx/d)*f}}\n  p.vx*=.97;p.vy*=.97;p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>W){p.vx*=-.8;p.x=Math.max(0,Math.min(W,p.x))}if(p.y<0||p.y>H){p.vy*=-.8;p.y=Math.max(0,Math.min(H,p.y))}\n  p.h=(p.h+.5)%360;const sp=Math.hypot(p.vx,p.vy);x.fillStyle='hsl('+(p.h+sp*20)+',90%,'+(50+Math.min(30,sp*6))+'%)';x.fillRect(p.x,p.y,2,2)}\n requestAnimationFrame(step)}\n$('#rs').onclick=()=>{P=[]};step();\n</script></body></html>\n"
}