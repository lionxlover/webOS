{
  "id": "agecalc",
  "type": "app",
  "name": "Age Calculator",
  "version": "1.2.0",
  "category": "Utilities",
  "icon": "🎂",
  "color": "#FF8A65",
  "desc": "Your life, in delightfully nerdy numbers",
  "long": "Enter your birthday and get your age in days, weeks, heartbeats, breaths and trips around the sun — plus a countdown to your next birthday. A fun little statistics toy for your Leonux desktop.",
  "changelog": "Full moons, Earth-laps and sleep estimates",
  "developer": "Leonux Community",
  "permissions": [
    "Runs offline",
    "Sandboxed"
  ],
  "window": {
    "width": 520,
    "height": 640
  },
  "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Age Calculator</title>\n<style>\n*{box-sizing:border-box;margin:0}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(165deg,#171322,#1f1a30 60%,#282041);color:#f0ecfa;height:100vh;display:flex;flex-direction:column;overflow:hidden;padding:18px;user-select:none}\nh1{font-size:18px}h1 span{color:#F48FB1}\n.set{display:flex;gap:10px;align-items:end;margin:12px 0 18px;flex-wrap:wrap}\n.set label{font-size:11px;color:#b6abc9;font-weight:700;display:block;margin-bottom:5px}\n.set input{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:11px;padding:11px 13px;color:#f0ecfa;font-size:15px;outline:none;font-weight:600}\n.set input:focus{border-color:#F48FB1}\n.btn{border:0;border-radius:11px;padding:12px 20px;font-weight:800;font-size:13.5px;cursor:pointer;background:#F48FB1;color:#2b0f22}\n.btn:active{transform:scale(.97)}\n.hero{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}\n.card{flex:1;min-width:120px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:16px;padding:14px 16px}\n.card small{font-size:10.5px;letter-spacing:.08em;color:#b6abc9;font-weight:700;text-transform:uppercase}\n.card b{display:block;font-size:26px;font-weight:800;margin-top:4px}\n.card b span{font-size:13px;font-weight:700;color:#b6abc9}\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(118px,1fr));gap:8px}\n.cell{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:10px 12px;font-size:11px;color:#b6abc9;font-weight:700}\n.cell b{display:block;font-size:16px;color:#f0ecfa;margin-top:2px}\n.fun{margin-top:14px;font-size:12.5px;line-height:1.7;color:#cec6de;background:rgba(255,255,255,.04);border-radius:14px;padding:12px 14px}\n.fun b{color:#F48FB1}\n</style></head><body>\n<h1>🎂 Age <span>Calculator</span></h1>\n<div class=\"set\">\n  <div><label>Your date of birth</label><input type=\"date\" id=\"dob\"></div>\n  <button class=\"btn\" id=\"go\">Calculate</button>\n</div>\n<div id=\"out\">\n  <div class=\"hero\">\n    <div class=\"card\"><small>Age</small><b id=\"age\">—</b></div>\n    <div class=\"card\"><small>Next birthday</small><b id=\"next\">—</b></div>\n    <div class=\"card\"><small>Born on a</small><b id=\"dow\">—</b></div>\n  </div>\n  <div class=\"grid\" id=\"grid\"></div>\n  <div class=\"fun\" id=\"fun\"></div>\n</div>\n<script>\n'use strict';\nvar dobEl=document.getElementById('dob');\nif(!dobEl.value)dobEl.value='2000-06-15';\nfunction fmt(n){return n.toLocaleString('en-US');}\nfunction calc(){\n  var dob=new Date(dobEl.value+'T00:00:00');\n  if(isNaN(dob)){document.getElementById('age').textContent='pick a date';return;}\n  var now=new Date();\n  var age=now.getFullYear()-dob.getFullYear();\n  var m=now.getMonth()-dob.getMonth();\n  if(m<0||(m===0&&now.getDate()<dob.getDate()))age--;\n  var ms=now-dob;\n  var days=Math.floor(ms/86400000);\n  var nextB=new Date(now.getFullYear(),dob.getMonth(),dob.getDate());\n  if(nextB<now)nextB=new Date(now.getFullYear()+1,dob.getMonth(),dob.getDate());\n  var dNext=Math.ceil((nextB-now)/86400000);\n  document.getElementById('age').innerHTML=age+' <span>years '+Math.max(0,m<0?m+12:m)+' months</span>';\n  document.getElementById('next').innerHTML=dNext===0?'🎂 TODAY!':dNext+' <span>days · '+nextB.toLocaleDateString('en-GB',{day:'numeric',month:'short'})+'</span>';\n  document.getElementById('dow').textContent=dob.toLocaleDateString('en-GB',{weekday:'long'});\n  var weeks=Math.floor(days/7),hours=Math.floor(ms/3600000),mins=Math.floor(ms/60000);\n  var heartbeats=Math.round(mins*72),breaths=Math.round(mins*15);\n  var sleepY=Math.round(days*8/24); // ≈8h/day\n  var grid=document.getElementById('grid');grid.innerHTML='';\n  [['Days alive',fmt(days)],['Weeks',fmt(weeks)],['Months',fmt(Math.floor(days/30.44))],['Hours',fmt(hours)],['Minutes',fmt(mins)],['Heartbeats ≈',fmt(heartbeats)],['Breaths ≈',fmt(breaths)],['Days asleep ≈',fmt(sleepY)],['Full moons',Math.floor(Math.round(days/29.53))],['Trips around the sun',age]]\n    .forEach(function(p){var c=document.createElement('div');c.className='cell';c.innerHTML=p[0]+'<b>'+p[1]+'</b>';grid.appendChild(c);});\n  var season=['winter','spring','summer','autumn'][Math.floor((dob.getMonth()/12*4))%4];\n  document.getElementById('fun').innerHTML=\n    'You have orbited the Sun <b>'+age+'</b> times and watched about <b>'+Math.floor(Math.round(days/29.53))+'</b> full moons. '+\n    'Your heart has beaten roughly <b>'+fmt(heartbeats)+'</b> times. If you walked 5 km every day, you would have covered <b>'+fmt(days*5)+'</b> km — that is <b>'+Math.round(days*5/40075*10)/10+'</b> times around the Earth. 🌍';\n}\ndocument.getElementById('go').onclick=calc;\ndobEl.addEventListener('change',calc);\ncalc();\n</script></body></html>\n"
}