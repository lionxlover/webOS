{
 "id": "gameoflife",
 "type": "app",
 "name": "Game of Life",
 "version": "1.0.0",
 "category": "Education",
 "icon": "🧬",
 "color": "#7EE787",
 "desc": "Conway's cellular automaton, draw and evolve",
 "long": "Paint cells, choose a preset pattern such as a glider or pulsar, and watch generations unfold at an adjustable speed on a wrap-around grid.",
 "changelog": "First release",
 "developer": "Leonux Community",
 "permissions": [
  "Runs offline",
  "Sandboxed"
 ],
 "window": {
  "width": 560,
  "height": 600,
  "minWidth": 380,
  "minHeight": 420
 },
 "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Game of Life</title><style>*{box-sizing:border-box;margin:0}\n:root{--bg:#10131c;--fg:#e8ecf6;--mut:#8b94ab;--ac:#7EE787;--line:rgba(255,255,255,.1);--card:rgba(255,255,255,.05)}\nhtml,body{height:100%}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(165deg,#10131c,#161a28);color:var(--fg);overflow:hidden;user-select:none;-webkit-user-select:none}\nbutton{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.08);border:1px solid var(--line);border-radius:9px;padding:7px 13px;cursor:pointer;transition:background .12s,transform .08s}\nbutton:hover{background:rgba(255,255,255,.15)}button:active{transform:scale(.96)}\nbutton.pri{background:var(--ac);color:#0b1020;border-color:transparent;font-weight:700}\ninput,select,textarea{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.07);border:1px solid var(--line);border-radius:8px;padding:6px 9px;outline:none;user-select:text;-webkit-user-select:text}\ninput:focus,select:focus,textarea:focus{border-color:var(--ac)}select option{background:#1b2030}\n.wrap{height:100%;display:flex;flex-direction:column;align-items:center;gap:10px;padding:14px;overflow:auto}\n.bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:center}\n.stat{font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:.06em;text-align:center}.stat b{display:block;color:var(--ac);font-size:20px;letter-spacing:0}\nh1{font-size:16px}h1 span{color:var(--ac)}\n.muted{color:var(--mut);font-size:12px}\ncanvas{display:block;max-width:100%}\nlabel{font-size:12px;color:var(--mut)}\n.wrap{padding:10px}canvas{border-radius:8px;background:#0b0e16;cursor:crosshair;touch-action:none;width:100%;flex:1;min-height:0}\n</style></head><body><div class=\"wrap\">\n<div class=\"bar\"><button class=\"pri\" id=\"run\">Play</button><button id=\"step\">Step</button><button id=\"rnd\">Random</button><button id=\"clr\">Clear</button>\n<select id=\"pat\"><option value=\"\">Stamp…</option><option value=\"glider\">Glider</option><option value=\"lwss\">Spaceship</option><option value=\"gun\">Gosper gun</option><option value=\"pulsar\">Pulsar</option><option value=\"rpent\">R-pentomino</option></select>\n<label>Speed <input type=\"range\" id=\"sp\" min=\"1\" max=\"60\" value=\"15\"></label><span class=\"muted\" id=\"inf\">Gen 0 · 0 alive</span></div>\n<canvas id=\"c\"></canvas>\n</div><script>\nconst cv=document.getElementById('c'),x=cv.getContext('2d'),$=s=>document.querySelector(s);const W=90,H=60;let g=new Uint8Array(W*H),gen=0,run=false,last=0,cur='';\nconst P={glider:['.O.','..O','OOO'],lwss:['.OOOO','O...O','....O','O..O.'],rpent:['.OO','OO.','.O.'],pulsar:['..OOO...OOO..','','O....O.O....O','O....O.O....O','O....O.O....O','..OOO...OOO..','','..OOO...OOO..','O....O.O....O','O....O.O....O','O....O.O....O','','..OOO...OOO..'],\ngun:['........................O...........','......................O.O...........','............OO......OO............OO','...........O...O....OO............OO','OO........O.....O...OO..............','OO........O...O.OO....O.O...........','..........O.....O.......O...........','...........O...O....................','............OO......................']};\nfunction size(){const r=cv.getBoundingClientRect();cv.width=r.width;cv.height=r.height;draw()}\nfunction stamp(k,ox,oy){P[k].forEach((row,j)=>[...row].forEach((ch,i)=>{if(ch==='O'){const a=(ox+i+W)%W,b=(oy+j+H)%H;g[b*W+a]=1}}))}\nfunction step(){const n=new Uint8Array(W*H);for(let y=0;y<H;y++)for(let xx=0;xx<W;xx++){let c=0;for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++)if(dx||dy)c+=g[((y+dy+H)%H)*W+(xx+dx+W)%W];const a=g[y*W+xx];n[y*W+xx]=(c===3||(a&&c===2))?1:0}g=n;gen++;draw()}\nfunction draw(){const cw=cv.width/W,ch=cv.height/H;x.fillStyle='#0b0e16';x.fillRect(0,0,cv.width,cv.height);x.fillStyle='#7EE787';let alive=0;for(let y=0;y<H;y++)for(let i=0;i<W;i++)if(g[y*W+i]){alive++;x.fillRect(i*cw+.5,y*ch+.5,cw-1,ch-1)}$('#inf').textContent='Gen '+gen+' · '+alive+' alive'}\nfunction loop(t){if(run&&t-last>1000/$('#sp').value){last=t;step()}requestAnimationFrame(loop)}\nfunction cellAt(e){const r=cv.getBoundingClientRect();return[Math.floor((e.clientX-r.left)/r.width*W),Math.floor((e.clientY-r.top)/r.height*H)]}\nlet paint=null;cv.onpointerdown=e=>{const[a,b]=cellAt(e);if(cur){stamp(cur,a,b);cur='';$('#pat').value=''}else{paint=g[b*W+a]?0:1;g[b*W+a]=paint}draw();cv.setPointerCapture(e.pointerId)};\ncv.onpointermove=e=>{if(paint===null)return;const[a,b]=cellAt(e);if(a>=0&&b>=0&&a<W&&b<H){g[b*W+a]=paint;draw()}};cv.onpointerup=()=>paint=null;\n$('#run').onclick=()=>{run=!run;$('#run').textContent=run?'Pause':'Play'};$('#step').onclick=step;$('#clr').onclick=()=>{g.fill(0);gen=0;draw()};\n$('#rnd').onclick=()=>{for(let i=0;i<g.length;i++)g[i]=Math.random()<.25?1:0;gen=0;draw()};$('#pat').onchange=e=>cur=e.target.value;\naddEventListener('resize',size);stamp('gun',5,5);stamp('glider',60,35);size();requestAnimationFrame(loop);\n</script></body></html>\n"
}