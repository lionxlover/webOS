{
  "id": "tictactoe",
  "type": "app",
  "name": "Tic-Tac-Toe XL",
  "version": "1.2.0",
  "category": "Games",
  "icon": "⭕",
  "color": "#F48FB1",
  "desc": "Classic ✕◯ with an unbeatable minimax AI",
  "long": "Tic-Tac-Toe XL brings the timeless duel to Leonux: play against a perfect minimax AI that never makes a mistake, or pass the keyboard for two-player matches. Score tracking, win highlighting and instant rematches included.",
  "changelog": "Smarter AI, win-line highlighting and session scores",
  "developer": "Leonux Community",
  "permissions": [
    "Runs offline",
    "Sandboxed"
  ],
  "window": {
    "width": 400,
    "height": 560
  },
  "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Tic-Tac-Toe XL</title>\n<style>\n*{box-sizing:border-box;margin:0}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(165deg,#0f1220,#171b2e 60%,#1d2340);color:#eef1fa;height:100vh;display:flex;flex-direction:column;overflow:hidden;user-select:none;-webkit-user-select:none;padding:18px}\nh1{font-size:18px;letter-spacing:.2px;display:flex;align-items:center;gap:10px}\nh1 .x{color:#7EE787}h1 .o{color:#F48FB1}\n.bar{display:flex;gap:8px;align-items:center;margin:12px 0 14px;flex-wrap:wrap}\n.seg{display:flex;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.09);border-radius:999px;padding:3px}\n.seg button{border:0;background:none;color:#aab2c8;font-size:12.5px;font-weight:600;padding:6px 14px;border-radius:999px;cursor:pointer}\n.seg button.on{background:#5B9DFA;color:#08111f}\n.status{font-size:13.5px;font-weight:600;min-height:20px;margin-bottom:10px}\n.status .x{color:#7EE787}.status .o{color:#F48FB1}\n.board{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;max-width:340px;aspect-ratio:1;margin:0 auto;width:100%}\n.cell{border-radius:16px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09);display:grid;place-items:center;font-size:44px;font-weight:800;cursor:pointer;transition:transform .12s,background .15s}\n.cell:hover{background:rgba(255,255,255,.09);transform:scale(1.03)}\n.cell.x{color:#7EE787}.cell.o{color:#F48FB1}\n.cell.win{background:rgba(126,231,135,.16);border-color:#7EE787;box-shadow:0 0 18px rgba(126,231,135,.25)}\n.cell svg{width:54%;height:54%}\n.score{display:flex;gap:10px;justify-content:center;margin-top:16px;font-size:12.5px}\n.score div{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);padding:8px 16px;border-radius:12px}\n.score b{font-size:16px;display:block;text-align:center}\n.btn{border:0;border-radius:10px;padding:8px 14px;font-weight:700;font-size:12.5px;cursor:pointer;background:rgba(255,255,255,.08);color:#eef1fa}\n.btn:active{transform:scale(.96)}\n</style></head><body>\n<h1><span class=\"x\">✕</span> Tic-Tac-Toe XL <span class=\"o\">◯</span></h1>\n<div class=\"bar\">\n  <div class=\"seg\"><button id=\"mAi\" class=\"on\">vs AI</button><button id=\"m2p\">2 Players</button></div>\n  <div class=\"seg\"><button id=\"dX\" class=\"on\">You: ✕</button><button id=\"dO\">You: ◯</button></div>\n  <span style=\"flex:1\"></span>\n  <button class=\"btn\" id=\"reset\">↻ New round</button>\n</div>\n<div class=\"status\" id=\"status\"></div>\n<div class=\"board\" id=\"board\"></div>\n<div class=\"score\"><div>✕ <b id=\"sx\">0</b></div><div>Draws <b id=\"sd\">0</b></div><div>◯ <b id=\"so\">0</b></div></div>\n<script>\n'use strict';\nvar LINES=[[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];\nvar board,turn,over=false,mode='ai',human='X',sx=0,so=0,sd=0,aiBusy=false;\nvar boardEl=document.getElementById('board'),statusEl=document.getElementById('status');\nvar SVG_X='<svg viewBox=\"0 0 100 100\" fill=\"none\" stroke=\"#7EE787\" stroke-width=\"11\" stroke-linecap=\"round\"><path d=\"M26 26 74 74M74 26 26 74\"/></svg>';\nvar SVG_O='<svg viewBox=\"0 0 100 100\" fill=\"none\" stroke=\"#F48FB1\" stroke-width=\"11\"><circle cx=\"50\" cy=\"50\" r=\"27\"/></svg>';\nfunction reset(){board=Array(9).fill(null);turn='X';over=false;aiBusy=false;draw();say((mode==='ai'?('You are '+(human==='X'?'✕':'◯')+' · '):'')+'✕ moves first');}\nfunction draw(){\n  boardEl.innerHTML='';\n  for(var i=0;i<9;i++){(function(i){\n    var c=document.createElement('div');c.className='cell'+(board[i]?' '+board[i].toLowerCase():'');\n    c.innerHTML=board[i]==='X'?SVG_X:board[i]==='O'?SVG_O:'';\n    c.onclick=function(){move(i)};boardEl.appendChild(c);\n  })(i);}\n}\nfunction say(t){statusEl.innerHTML=t;}\nfunction winLine(b){for(var i=0;i<LINES.length;i++){var l=LINES[i];if(b[l[0]]&&b[l[0]]===b[l[1]]&&b[l[0]]===b[l[2]])return l;}return null;}\nfunction winner(b){var l=winLine(b);return l?b[l[0]]:(b.every(function(x){return x})?'D':null);}\nfunction markWin(l){if(!l)return;var cells=boardEl.children;l.forEach(function(i){cells[i].classList.add('win');});}\nfunction move(i){\n  if(over||board[i]||aiBusy)return;\n  if(mode==='ai'&&turn!==human)return;\n  play(i);\n}\nfunction play(i){\n  board[i]=turn;draw();\n  var w=winner(board);\n  if(w){end(w);return;}\n  turn=turn==='X'?'O':'X';say(turn==='X'?'✕ moves':'◯ moves');\n  if(mode==='ai'&&turn!==human){aiBusy=true;say('AI is thinking…');setTimeout(function(){play(best());aiBusy=false;},420+Math.random()*380);}\n}\nfunction end(w){\n  over=true;\n  if(w==='D'){sd++;say('Draw — well fought!');}\n  else{\n    var l=winLine(board);markWin(l);\n    if(w==='X')sx++;else so++;\n    var youWin=mode==='ai'&&w===human;\n    say('<span class=\"'+w.toLowerCase()+'\">'+(w==='X'?'✕':'◯')+' wins!</span> '+(mode==='ai'?(youWin?'You beat the AI! 🎉':'The AI takes it.'):''));\n  }\n  document.getElementById('sx').textContent=sx;document.getElementById('sd').textContent=sd;document.getElementById('so').textContent=so;\n}\nfunction best(){ // minimax — unbeatable\n  var b=board.slice(),me=turn;\n  function score(b,d){var w=winner(b);if(w==='D')return 0;return w===me?10-d:d-10;}\n  function mm(b,d,maxing){\n    var w=winner(b);if(w)return score(b,d);\n    var bestV=maxing?-99:99,bestI=-1;\n    for(var i=0;i<9;i++){if(b[i])continue;b[i]=maxing?me:(me==='X'?'O':'X');\n      var v=mm(b,d+1,!maxing);b[i]=null;\n      if(maxing?v>bestV:v<bestV){bestV=v;bestI=i;}}\n    return d===0?(bestI>=0?bestI:bestVal):bestVal;\n  }\n  // pick first empty with best value\n  var bestVal=-99,pick=-1;\n  for(var i=0;i<9;i++){if(b[i])continue;b[i]=me;var v=mm(b,1,false);b[i]=null;if(v>bestVal){bestVal=v;pick=i;}}\n  return pick>=0?pick:b.findIndex(function(x){return !x;});\n}\ndocument.getElementById('reset').onclick=reset;\ndocument.getElementById('mAi').onclick=function(){mode='ai';seg(this,'mAi','m2p');reset();};\ndocument.getElementById('m2p').onclick=function(){mode='2p';seg(this,'mAi','m2p');reset();};\ndocument.getElementById('dX').onclick=function(){human='X';seg(this,'dX','dO');reset();};\ndocument.getElementById('dO').onclick=function(){human='O';seg(this,'dX','dO');reset();};\nfunction seg(el,a,b){el.classList.add('on');document.getElementById(el.id===a?b:a).classList.remove('on');}\nreset();\n</script></body></html>\n"
}