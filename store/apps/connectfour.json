{
 "id": "connectfour",
 "type": "app",
 "name": "Connect Four",
 "version": "1.0.0",
 "category": "Games",
 "icon": "🔴",
 "color": "#f43f5e",
 "desc": "Drop discs, line up four — vs a minimax CPU",
 "long": "The classic vertical strategy game with a depth-limited minimax opponent. Choose Easy, Medium or Hard, track wins and draws, and hover a column to preview your drop.",
 "changelog": "First release",
 "developer": "Leonux Community",
 "permissions": [
  "Runs offline",
  "Sandboxed"
 ],
 "window": {
  "width": 480,
  "height": 560,
  "minWidth": 360,
  "minHeight": 480
 },
 "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Connect Four</title><style>*{box-sizing:border-box;margin:0}\n:root{--bg:#10131c;--fg:#e8ecf6;--mut:#8b94ab;--ac:#7EE787;--line:rgba(255,255,255,.1);--card:rgba(255,255,255,.05)}\nhtml,body{height:100%}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(165deg,#10131c,#161a28);color:var(--fg);overflow:hidden;user-select:none;-webkit-user-select:none}\nbutton{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.08);border:1px solid var(--line);border-radius:9px;padding:7px 13px;cursor:pointer;transition:background .12s,transform .08s}\nbutton:hover{background:rgba(255,255,255,.15)}button:active{transform:scale(.96)}\nbutton.pri{background:var(--ac);color:#0b1020;border-color:transparent;font-weight:700}\ninput,select,textarea{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.07);border:1px solid var(--line);border-radius:8px;padding:6px 9px;outline:none;user-select:text;-webkit-user-select:text}\ninput:focus,select:focus,textarea:focus{border-color:var(--ac)}select option{background:#1b2030}\n.wrap{height:100%;display:flex;flex-direction:column;align-items:center;gap:10px;padding:14px;overflow:auto}\n.bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:center}\n.stat{font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:.06em;text-align:center}.stat b{display:block;color:var(--ac);font-size:20px;letter-spacing:0}\nh1{font-size:16px}h1 span{color:var(--ac)}\n.muted{color:var(--mut);font-size:12px}\ncanvas{display:block;max-width:100%}\nlabel{font-size:12px;color:var(--mut)}\ncanvas{border-radius:14px;cursor:pointer;touch-action:manipulation}\n.sw{display:inline-block;width:12px;height:12px;border-radius:50%;vertical-align:-1px;margin-right:5px}\n</style></head><body><div class=\"wrap\">\n<h1>Connect <span>Four</span></h1>\n<div class=\"bar\"><div class=\"stat\">You<b id=\"sy\">0</b></div><div class=\"stat\">Draws<b id=\"sd\">0</b></div><div class=\"stat\" id=\"who\">CPU<b id=\"sc\">0</b></div></div>\n<canvas id=\"c\" width=\"420\" height=\"360\"></canvas>\n<div class=\"bar\"><span id=\"msg\" class=\"muted\">Your move — click a column</span><select id=\"lvl\"><option value=\"2\">Easy</option><option value=\"4\" selected>Medium</option><option value=\"6\">Hard</option></select><button class=\"pri\" id=\"new\">New game</button></div>\n</div><script>\nconst R=6,Cn=7,cv=document.getElementById('c'),x=cv.getContext('2d'),S=60;\nlet g,turn,over,win,score={y:0,d:0,c:0},hover=-1,busy=false;\nconst $=s=>document.querySelector(s);\nfunction reset(){g=Array.from({length:R},()=>Array(Cn).fill(0));turn=1;over=false;win=null;busy=false;$('#msg').textContent='Your move — click a column';draw()}\nfunction drop(b,c,p){for(let r=R-1;r>=0;r--)if(!b[r][c]){b[r][c]=p;return r}return -1}\nfunction check(b,p){const D=[[0,1],[1,0],[1,1],[1,-1]];for(let r=0;r<R;r++)for(let c=0;c<Cn;c++){if(b[r][c]!==p)continue;for(const[dr,dc]of D){const cells=[[r,c]];for(let k=1;k<4;k++){const rr=r+dr*k,cc=c+dc*k;if(rr<0||rr>=R||cc<0||cc>=Cn||b[rr][cc]!==p)break;cells.push([rr,cc])}if(cells.length===4)return cells}}return null}\nfunction full(b){return b[0].every(v=>v)}\nfunction evalB(b){let s=0;const W=(a)=>{const n2=a.filter(v=>v===2).length,n1=a.filter(v=>v===1).length,e=a.filter(v=>!v).length;if(n2===4)s+=1000;else if(n2===3&&e===1)s+=8;else if(n2===2&&e===2)s+=2;if(n1===3&&e===1)s-=9};\n for(let r=0;r<R;r++)for(let c=0;c<Cn;c++){if(c+3<Cn)W([0,1,2,3].map(k=>b[r][c+k]));if(r+3<R)W([0,1,2,3].map(k=>b[r+k][c]));if(r+3<R&&c+3<Cn)W([0,1,2,3].map(k=>b[r+k][c+k]));if(r+3<R&&c-3>=0)W([0,1,2,3].map(k=>b[r+k][c-k]))}\n for(let r=0;r<R;r++)if(b[r][3]===2)s+=3;return s}\nfunction mm(b,d,a,be,max){if(check(b,2))return 1e5+d;if(check(b,1))return -1e5-d;if(full(b))return 0;if(!d)return evalB(b);const order=[3,2,4,1,5,0,6];let v=max?-1e9:1e9;for(const c of order){if(b[0][c])continue;const r=drop(b,c,max?2:1);const s=mm(b,d-1,a,be,!max);b[r][c]=0;if(max){v=Math.max(v,s);a=Math.max(a,v)}else{v=Math.min(v,s);be=Math.min(be,v)}if(a>=be)break}return v}\nfunction cpu(){const d=+$('#lvl').value;let best=-1,bs=-1e9;const cols=[3,2,4,1,5,0,6].filter(c=>!g[0][c]);for(const c of cols){const r=drop(g,c,2);let s=mm(g,d-1,-1e9,1e9,false)+(d===2?Math.random()*40:0);g[r][c]=0;if(s>bs){bs=s;best=c}}return best}\nfunction place(c,p){const r=drop(g,c,p);if(r<0)return false;const w=check(g,p);if(w){over=true;win=w;if(p===1){score.y++;$('#msg').textContent='You win!'}else{score.c++;$('#msg').textContent='CPU wins'}}else if(full(g)){over=true;score.d++;$('#msg').textContent='Draw'}$('#sy').textContent=score.y;$('#sd').textContent=score.d;$('#sc').textContent=score.c;draw();return true}\ncv.onclick=e=>{if(over||busy)return;const rc=cv.getBoundingClientRect(),c=Math.floor((e.clientX-rc.left)/rc.width*Cn);if(!place(c,1))return;if(over)return;busy=true;$('#msg').textContent='CPU thinking…';setTimeout(()=>{place(cpu(),2);busy=false;if(!over)$('#msg').textContent='Your move'},60)};\ncv.onmousemove=e=>{const rc=cv.getBoundingClientRect();hover=Math.floor((e.clientX-rc.left)/rc.width*Cn);draw()};cv.onmouseleave=()=>{hover=-1;draw()};\nfunction draw(){x.clearRect(0,0,420,360);x.fillStyle='#1d4ed8';x.beginPath();x.roundRect(0,0,420,360,14);x.fill();\n for(let r=0;r<R;r++)for(let c=0;c<Cn;c++){const v=g[r][c];x.beginPath();x.arc(c*S+30,r*S+30,24,0,7);x.fillStyle=v===1?'#facc15':v===2?'#ef4444':(hover===c&&!over?'#274fb5':'#0b1d57');x.fill()}\n if(win){x.strokeStyle='#fff';x.lineWidth=5;x.beginPath();x.moveTo(win[0][1]*S+30,win[0][0]*S+30);x.lineTo(win[3][1]*S+30,win[3][0]*S+30);x.stroke()}}\n$('#new').onclick=reset;reset();\n</script></body></html>\n"
}