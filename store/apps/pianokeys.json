{
  "id": "pianokeys",
  "type": "app",
  "name": "Piano Keys",
  "version": "1.2.0",
  "category": "Media",
  "icon": "🎹",
  "color": "#E0AF68",
  "desc": "A playable synthesizer keyboard",
  "long": "A real Web Audio synthesizer: one or two octaves of ivory with proper black-key geometry, three voices (piano, electric, music box), adjustable sustain, and full keyboard mapping — the on-key letters show you where to press.",
  "changelog": "Second octave and voice selection",
  "developer": "Leonux Community",
  "permissions": [
    "Runs offline",
    "Sandboxed"
  ],
  "window": {
    "width": 760,
    "height": 430
  },
  "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Piano Keys</title>\n<style>\n*{box-sizing:border-box;margin:0}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(170deg,#191420,#221a2e 55%,#2a1f3a);color:#f2edf8;height:100vh;display:flex;flex-direction:column;overflow:hidden;user-select:none;padding:14px}\nh1{font-size:17px}h1 span{color:#F6C177}\n.top{display:flex;gap:8px;align-items:center;margin:8px 0 10px;font-size:12px;flex-wrap:wrap}\n.seg{display:flex;background:rgba(255,255,255,.06);border-radius:999px;padding:3px}\n.seg button{border:0;background:none;color:#cbbfd8;padding:5px 12px;border-radius:999px;font-size:12px;font-weight:700;cursor:pointer}\n.seg button.on{background:#F6C177;color:#241a08}\n.kb{flex:1;display:flex;position:relative;padding-top:6px;min-height:220px}\n.white{flex:1;background:linear-gradient(180deg,#fdfdff,#e8e6ef);border:1px solid #b9b4c6;border-radius:0 0 10px 10px;margin:0 2px;position:relative;cursor:pointer;box-shadow:inset 0 -8px 0 rgba(0,0,0,.06)}\n.white.dn{background:linear-gradient(180deg,#f4e9d4,#e9d9b8)}\n.white span{position:absolute;bottom:10px;left:0;right:0;text-align:center;font-size:11px;color:#7d7590;font-weight:700}\n.black{position:absolute;width:6.4%;height:62%;background:linear-gradient(180deg,#2b2534,#151119);border-radius:0 0 8px 8px;z-index:2;cursor:pointer;box-shadow:0 6px 10px rgba(0,0,0,.4);border:1px solid #000}\n.black.dn{background:linear-gradient(180deg,#4a3d28,#2b2519)}\n.black span{position:absolute;bottom:8px;left:0;right:0;text-align:center;font-size:10px;color:#9a90ac;font-weight:700}\n.now{position:fixed;bottom:12px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.5);padding:6px 16px;border-radius:999px;font-size:12.5px;font-weight:700;color:#F6C177}\n.help{font-size:11px;color:#b0a4c2;margin-top:8px}\n</style></head><body>\n<h1>🎹 Piano <span>Keys</span></h1>\n<div class=\"top\">\n  <div class=\"seg\"><button id=\"sP\" class=\"on\">Piano</button><button id=\"sE\">Electric</button><button id=\"sM\">Music box</button></div>\n  <div class=\"seg\"><button id=\"l1\" class=\"on\">1 octave</button><button id=\"l2\">2 octaves</button></div>\n  <div style=\"color:#b0a4c2\">Sustain: <input type=\"range\" id=\"rel\" min=\"0.3\" max=\"3\" step=\"0.1\" value=\"1.2\" style=\"vertical-align:middle;width:90px\"></div>\n</div>\n<div class=\"kb\" id=\"kb\"></div>\n<div class=\"help\">Play with your mouse / touch, or use the letter keys shown on each note (Z–M lower row, Q–P upper). A / L shift octaves.</div>\n<div class=\"now\" id=\"now\">Ready — play a note 🎵</div>\n<script>\n'use strict';\nvar ac=null,wave='triangle',vol=0.32;\nfunction ctx(){if(!ac)ac=new (window.AudioContext||window.webkitAudioContext)();if(ac.state==='suspended')ac.resume();return ac;}\nfunction note(f,dur){\n  var c=ctx(),o=c.createOscillator(),g=c.createGain(),t=c.currentTime;\n  o.type=wave;o.frequency.value=f;\n  g.gain.setValueAtTime(0.0001,t);\n  g.gain.exponentialRampToValueAtTime(vol,t+0.015);\n  g.gain.exponentialRampToValueAtTime(0.0001,t+dur);\n  o.connect(g);g.connect(c.destination);o.start(t);o.stop(t+dur+0.05);\n}\nvar NAMES=['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];\nfunction freq(semiFromA4){return 440*Math.pow(2,(semiFromA4-9)/12);} // C4 = semi 0\nvar KEYS1=[['a',0],['w',1],['s',2],['e',3],['d',4],['f',5],['t',6],['g',7],['y',8],['h',9],['u',10],['j',11],['k',12],['o',13],['l',14],['p',15],[';',16]];\nvar KEYS2=[['z',-12],['s2',-11],['x',-10],['d2',-9],['c',-8],['v',-7],['g2',-6],['b',-5],['h2',-4],['n',-3],['j2',-2],['m',-1]].concat(KEYS1);\nvar octaves=1,offset=0,kb=document.getElementById('kb'),nowEl=document.getElementById('now');\nvar KEYMAP={};\nfunction build(){\n  kb.innerHTML='';KEYMAP={};\n  var whites=[],keys=octaves===1?KEYS1:KEYS2;\n  keys.forEach(function(k){var semi=k[1];\n    if(NAMES[((semi%12)+12)%12].indexOf('#')<0)whites.push(k);\n  });\n  whites.forEach(function(k,i){\n    var el=document.createElement('div');el.className='white';\n    el.innerHTML='<span>'+NAMES[((k[1]%12)+12)%12]+(Math.floor(k[1]/12)+4)+(k[0].length===1?' ⌨ '+k[0].toUpperCase():'')+'</span>';\n    bind(el,k);kb.appendChild(el);if(k[0].length===1&&k[0]!=='l'&&k[0]!=='p')KEYMAP[k[0]]=el;\n  });\n  keys.forEach(function(k){\n    var semi=k[1],n=NAMES[((semi%12)+12)%12];\n    if(n.indexOf('#')<0)return;\n    // position between whites\n    var idx=0;whites.forEach(function(w,i){if(w[1]<semi)idx=i+1;});\n    var el=document.createElement('div');el.className='black';\n    el.style.left='calc('+(idx*100/whites.length)+'% - 3.2%)';\n    el.innerHTML='<span>'+(k[0].length===1?'⌨ '+k[0].toUpperCase():'')+'</span>';\n    bind(el,k);kb.appendChild(el);if(k[0].length===1)KEYMAP[k[0]]=el;\n  });\n}\nfunction bind(el,k){\n  function down(e){e.preventDefault();el.classList.add('dn');var f=freq(k[1]+offset);note(f,parseFloat(document.getElementById('rel').value));nowEl.textContent='♪ '+NAMES[((k[1]%12)+12)%12]+(Math.floor((k[1]+offset)/12)+4)+' · '+f.toFixed(1)+' Hz';}\n  function up(){el.classList.remove('dn');}\n  el.addEventListener('pointerdown',down);el.addEventListener('pointerup',up);el.addEventListener('pointerleave',up);\n}\ndocument.addEventListener('keydown',function(e){\n  if(e.repeat)return;var k=e.key.toLowerCase();\n  if(k==='a'&&octaves===1){/*a is a note key*/}\n  if(KEYMAP[k]&&k.length===1){KEYMAP[k].classList.add('dn');note(freq(KEYMAP[k]._semi+offset),parseFloat(document.getElementById('rel').value));}\n});\ndocument.addEventListener('keyup',function(e){var k=e.key.toLowerCase();if(KEYMAP[k])KEYMAP[k].classList.remove('dn');});\n// store semis for keydown\nvar _bind=bind;bind=function(el,k){el._semi=k[1];_bind(el,k);};\ndocument.getElementById('sP').onclick=function(){setWave(this,'triangle','sP','sE','sM');};\ndocument.getElementById('sE').onclick=function(){setWave(this,'sawtooth','sP','sE','sM');vol=0.22;};\ndocument.getElementById('sM').onclick=function(){setWave(this,'sine','sP','sE','sM');vol=0.4;};\nfunction setWave(el,w){wave=w;['sP','sE','sM'].forEach(function(id){document.getElementById(id).classList.toggle('on',id===el.id);});}\ndocument.getElementById('l1').onclick=function(){octaves=1;this.classList.add('on');document.getElementById('l2').classList.remove('on');build();};\ndocument.getElementById('l2').onclick=function(){octaves=2;this.classList.add('on');document.getElementById('l1').classList.remove('on');build();};\nbuild();\n</script></body></html>\n"
}