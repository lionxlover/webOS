{
  "id": "passforge",
  "type": "app",
  "name": "Password Forge",
  "version": "1.2.0",
  "category": "Utilities",
  "icon": "🔐",
  "color": "#4DD0E1",
  "desc": "Cryptographically strong password generator",
  "long": "Forge passwords with the Web Crypto API: pick your length and character sets, watch live entropy bits and a strength meter, then copy with one tap. Nothing is stored or transmitted — generated locally, gone when you close the window.",
  "changelog": "Entropy readout and click-anywhere-to-copy",
  "developer": "Leonux Community",
  "permissions": [
    "Runs offline",
    "Sandboxed"
  ],
  "window": {
    "width": 460,
    "height": 620
  },
  "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Password Forge</title>\n<style>\n*{box-sizing:border-box;margin:0}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(165deg,#0f1416,#131b1e 60%,#172328);color:#e9f2f4;height:100vh;display:flex;flex-direction:column;overflow:hidden;padding:18px;user-select:none}\nh1{font-size:18px}h1 span{color:#4DD0E1}\n.out{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:16px;margin:14px 0;font-family:ui-monospace,'SF Mono',Menlo,Consolas,monospace;font-size:17px;letter-spacing:.4px;word-break:break-all;min-height:64px;display:flex;align-items:center;cursor:pointer;transition:border-color .15s}\n.out:hover{border-color:#4DD0E1}\n.out .tag{margin-left:auto;font-family:inherit;font-size:10px;background:rgba(77,208,225,.15);color:#4DD0E1;border-radius:6px;padding:2px 7px;flex:0 0 auto;margin-left:10px}\n.ctl{display:flex;align-items:center;gap:10px;margin:12px 0;font-size:13px}\n.ctl label{width:92px;color:#a9bcc1;font-weight:600}\ninput[type=range]{flex:1;accent-color:#4DD0E1}\n.ctl b{width:34px;text-align:right;font-size:14px}\n.opts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0 14px}\n.opt{display:flex;align-items:center;gap:9px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);border-radius:11px;padding:10px 12px;font-size:13px;cursor:pointer;font-weight:600}\n.opt input{accent-color:#4DD0E1;width:16px;height:16px}\n.meter{height:8px;border-radius:4px;background:rgba(255,255,255,.08);overflow:hidden}\n.meter i{display:block;height:100%;width:10%;border-radius:4px;background:#F28B82;transition:width .25s,background .25s}\n.meta{display:flex;justify-content:space-between;font-size:11.5px;color:#a9bcc1;margin:6px 2px 0}\n.row{display:flex;gap:8px;margin-top:12px}\n.btn{flex:1;border:0;border-radius:11px;padding:12px;font-weight:800;font-size:13.5px;cursor:pointer}\n.btn:active{transform:scale(.98)}\n.gen{background:#4DD0E1;color:#06222a}\n.cp{background:rgba(255,255,255,.08);color:#e9f2f4}\n.note{font-size:11px;color:#7e9297;margin-top:12px;line-height:1.5}\n.toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%) translateY(60px);background:#172328;color:#4DD0E1;border:1px solid rgba(77,208,225,.4);padding:9px 18px;border-radius:999px;font-size:13px;font-weight:700;transition:transform .25s}\n.toast.show{transform:translateX(-50%) translateY(0)}\n</style></head><body>\n<h1>🔐 Password <span>Forge</span></h1>\n<div class=\"out\" id=\"out\" title=\"Click to copy\"><span id=\"pw\">generating…</span><span class=\"tag\" id=\"len\">—</span></div>\n<div class=\"ctl\"><label>Length</label><input type=\"range\" id=\"lenR\" min=\"6\" max=\"64\" value=\"18\"><b id=\"lenV\">18</b></div>\n<div class=\"opts\">\n  <label class=\"opt\"><input type=\"checkbox\" id=\"oU\" checked>ABC Upper</label>\n  <label class=\"opt\"><input type=\"checkbox\" id=\"oL\" checked>abc lower</label>\n  <label class=\"opt\"><input type=\"checkbox\" id=\"oN\" checked>123 Numbers</label>\n  <label class=\"opt\"><input type=\"checkbox\" id=\"oS\" checked>#$& Symbols</label>\n</div>\n<div class=\"meter\"><i id=\"bar\"></i></div>\n<div class=\"meta\"><span id=\"strength\">—</span><span id=\"entropy\">—</span></div>\n<div class=\"row\"><button class=\"btn gen\" id=\"gen\">⚒ Forge password</button><button class=\"btn cp\" id=\"cp\">⧉ Copy</button></div>\n<div class=\"note\">Passwords are generated locally in this window and never leave your device. Nothing is stored or transmitted — close the app and it is gone forever.</div>\n<div class=\"toast\" id=\"toast\">Copied to clipboard</div>\n<script>\n'use strict';\nvar SETS={U:'ABCDEFGHJKLMNPQRSTUVWXYZ',L:'abcdefghijkmnopqrstuvwxyz',N:'23456789',S:'!@#$%^&*()-_=+[]{};:,.?/~'};\nvar pwEl=document.getElementById('pw'),outEl=document.getElementById('out'),bar=document.getElementById('bar'),strengthEl=document.getElementById('strength'),entropyEl=document.getElementById('entropy');\nvar rnd=new Uint32Array(1);\nfunction ri(n){crypto.getRandomValues(rnd);return rnd[0]%n;}\nfunction gen(){\n  var pool='';\n  if(document.getElementById('oU').checked)pool+=SETS.U;\n  if(document.getElementById('oL').checked)pool+=SETS.L;\n  if(document.getElementById('oN').checked)pool+=SETS.N;\n  if(document.getElementById('oS').checked)pool+=SETS.S;\n  if(!pool){pwEl.textContent='Select at least one set';return;}\n  var len=+document.getElementById('lenR').value,out='';\n  for(var i=0;i<len;i++)out+=pool[ri(pool.length)];\n  pwEl.textContent=out;\n  document.getElementById('len').textContent=len+' chars';\n  var bits=Math.round(len*Math.log2(pool.length));\n  entropyEl.textContent='≈ '+bits+' bits of entropy';\n  var pct=Math.min(100,bits/100*100);\n  bar.style.width=Math.max(6,pct)+'%';\n  var lvl,txt;\n  if(bits<40){bar.style.background='#F28B82';lvl='Weak';}\n  else if(bits<65){bar.style.background='#F6C177';lvl='Fair';}\n  else if(bits<90){bar.style.background='#9ECE6A';lvl='Strong';}\n  else{bar.style.background='#4DD0E1';lvl='Fortress 🔒';}\n  strengthEl.textContent='Strength: '+lvl+' · pool of '+pool.length+' characters';\n}\ndocument.getElementById('gen').onclick=gen;\ndocument.getElementById('lenR').oninput=function(){document.getElementById('lenV').textContent=this.value;gen();};\n['oU','oL','oN','oS'].forEach(function(id){document.getElementById(id).onchange=gen;});\nfunction copy(){\n  var t=pwEl.textContent;\n  try{navigator.clipboard.writeText(t);}catch(e){\n    var ta=document.createElement('textarea');ta.value=t;document.body.appendChild(ta);ta.select();try{document.execCommand('copy');}catch(x){}ta.remove();\n  }\n  var to=document.getElementById('toast');to.classList.add('show');setTimeout(function(){to.classList.remove('show')},1400);\n}\ndocument.getElementById('cp').onclick=copy;\noutEl.onclick=copy;\ngen();\n</script></body></html>\n"
}