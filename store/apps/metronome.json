{
  "id": "metronome",
  "type": "app",
  "name": "Metronome",
  "version": "1.2.0",
  "category": "Media",
  "icon": "🎵",
  "color": "#94B3FD",
  "desc": "Precision metronome with tap tempo",
  "long": "A musician's metronome built on Web Audio scheduling: 30–240 BPM with a big tap-tempo dial, 2/4 to 6/8 time signatures with accented downbeats, and visual beat dots. Space bar starts and stops.",
  "changelog": "Tap tempo dial and 6/8 support",
  "developer": "Leonux Community",
  "permissions": [
    "Runs offline",
    "Sandboxed"
  ],
  "window": {
    "width": 420,
    "height": 640
  },
  "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Metronome</title>\n<style>\n*{box-sizing:border-box;margin:0}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(170deg,#131722,#181e2e 60%,#1d2438);color:#eaeff9;height:100vh;display:flex;flex-direction:column;overflow:hidden;user-select:none;padding:18px;align-items:center}\nh1{font-size:18px;align-self:flex-start}h1 span{color:#F6C177}\n.dial{position:relative;width:230px;height:230px;border-radius:50%;background:conic-gradient(from 180deg,rgba(246,193,119,.85),rgba(246,193,119,.06) 22%,rgba(255,255,255,.04) 78%,rgba(246,193,119,.85));display:grid;place-items:center;margin:18px 0;cursor:pointer;transition:transform .08s}\n.dial:active{transform:scale(.97)}\n.dial-in{width:186px;height:186px;border-radius:50%;background:#161b28;display:grid;place-items:center;text-align:center;box-shadow:inset 0 4px 18px rgba(0,0,0,.5)}\n.bpm{font-size:52px;font-weight:200;letter-spacing:-2px;line-height:1}\n.bpm-lbl{font-size:11px;letter-spacing:.22em;color:#8d97ad;font-weight:700;margin-top:4px}\n.tap{font-size:10.5px;color:#F6C177;margin-top:6px;font-weight:700}\n.ctl{display:flex;align-items:center;gap:14px;margin:4px 0 12px}\n.ctl button{width:46px;height:46px;border-radius:50%;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.06);color:#eaeff9;font-size:19px;font-weight:800;cursor:pointer}\n.ctl button:active{transform:scale(.93)}\n.beat{display:flex;gap:12px;margin:10px 0 16px}\n.beat i{width:15px;height:15px;border-radius:50%;background:rgba(255,255,255,.1);transition:all .08s}\n.beat i.on{background:#F6C177;box-shadow:0 0 14px rgba(246,193,119,.7);transform:scale(1.28)}\n.row{display:flex;gap:8px;flex-wrap:wrap;justify-content:center}\n.chip{border:1px solid rgba(255,255,255,.13);background:rgba(255,255,255,.05);color:#c6cede;border-radius:999px;padding:7px 14px;font-size:12px;font-weight:700;cursor:pointer}\n.chip.on{background:#F6C177;color:#241a08;border-color:#F6C177}\n.go{border:0;border-radius:14px;padding:14px 44px;font-size:16px;font-weight:800;cursor:pointer;background:#F6C177;color:#241a08;margin-top:14px}\n.go.stop{background:#F28B82;color:#2b0f0d}\n.hint{font-size:11px;color:#8d97ad;margin-top:12px}\n</style></head><body>\n<h1>🎵 Metro<span>nome</span></h1>\n<div class=\"dial\" id=\"dial\"><div class=\"dial-in\"><div class=\"bpm\" id=\"bpm\">120</div><div class=\"bpm-lbl\">BPM · TAP TEMPO</div><div class=\"tap\">tap the dial in rhythm</div></div></div>\n<div class=\"ctl\">\n  <button id=\"minus\">−</button>\n  <input type=\"range\" id=\"slider\" min=\"30\" max=\"240\" value=\"120\" style=\"width:180px;accent-color:#F6C177\">\n  <button id=\"plus\">+</button>\n</div>\n<div class=\"beat\" id=\"beat\"></div>\n<div class=\"row\" id=\"sigs\"></div>\n<button class=\"go\" id=\"go\">▶ START</button>\n<div class=\"hint\">Web Audio precision timing · space bar starts / stops</div>\n<script>\n'use strict';\nvar bpm=120,sig=4,running=false,nextT=0,idx=0,timer=null,taps=[];\nvar ac=null;\nfunction ctx(){if(!ac)ac=new (window.AudioContext||window.webkitAudioContext)();if(ac.state==='suspended')ac.resume();return ac;}\nfunction click(accent){\n  var c=ctx(),o=c.createOscillator(),g=c.createGain(),t=c.currentTime;\n  o.type='sine';o.frequency.value=accent?1568:1046;\n  g.gain.setValueAtTime(accent?0.5:0.32,t);g.gain.exponentialRampToValueAtTime(0.0001,t+0.06);\n  o.connect(g);g.connect(c.destination);o.start(t);o.stop(t+0.08);\n  var b=beatEl.children;for(var i=0;i<b.length;i++)b[i].classList.toggle('on',i===idx);\n}\nvar bpmEl=document.getElementById('bpm'),slider=document.getElementById('slider'),beatEl=document.getElementById('beat'),goBtn=document.getElementById('go');\nfunction setBpm(v){bpm=Math.round(Math.max(30,Math.min(240,v)));bpmEl.textContent=bpm;slider.value=bpm;}\nfunction buildBeat(){beatEl.innerHTML='';for(var i=0;i<sig;i++)beatEl.appendChild(document.createElement('i'));}\nfunction schedule(){\n  if(!running)return;\n  var c=ctx();\n  while(nextT<c.currentTime+0.12){\n    (function(t,i){\n      setTimeout(function(){if(running)click(i===0);},Math.max(0,(t-c.currentTime)*1000));\n    })(nextT,idx);\n    idx=(idx+1)%sig;\n    nextT+=60/bpm;\n  }\n  timer=setTimeout(schedule,40);\n}\nfunction start(){\n  running=true;idx=0;var c=ctx();nextT=c.currentTime+0.08;\n  goBtn.textContent='⏸ STOP';goBtn.classList.add('stop');\n  schedule();\n}\nfunction stop(){\n  running=false;clearTimeout(timer);\n  goBtn.textContent='▶ START';goBtn.classList.remove('stop');\n  for(var i=0;i<beatEl.children.length;i++)beatEl.children[i].classList.remove('on');\n}\ngoBtn.onclick=function(){running?stop():start();};\ndocument.getElementById('minus').onclick=function(){setBpm(bpm-2)};\ndocument.getElementById('plus').onclick=function(){setBpm(bpm+2)};\nslider.oninput=function(){setBpm(+this.value)};\ndocument.getElementById('dial').onclick=function(){\n  var now=performance.now();\n  taps=taps.filter(function(t){return now-t<2500;});taps.push(now);\n  if(taps.length>=3){\n    var iv=(taps[taps.length-1]-taps[0])/(taps.length-1);\n    setBpm(60000/iv);\n  }\n};\nvar sigs=[[2,'2/4'],[3,'3/4'],[4,'4/4'],[6,'6/8']],sigRow=document.getElementById('sigs');\nsigs.forEach(function(s){\n  var c=document.createElement('div');c.className='chip'+(s[0]===4?' on':'');c.textContent=s[1];\n  c.onclick=function(){sig=s[0];Array.prototype.forEach.call(sigRow.children,function(x){x.classList.toggle('on',x===c);});buildBeat();};\n  sigRow.appendChild(c);\n});\ndocument.addEventListener('keydown',function(e){if(e.key===' '){e.preventDefault();running?stop():start();}});\nbuildBeat();\n</script></body></html>\n"
}