{
 "id": "mandelbrot",
 "type": "app",
 "name": "Mandelbrot Explorer",
 "version": "1.0.0",
 "category": "Education",
 "icon": "🌌",
 "color": "#818cf8",
 "desc": "Zoom endlessly into the Mandelbrot set",
 "long": "Click to zoom, right-click to zoom out, change the iteration depth and colour palette. Rendering is progressive so the UI stays responsive.",
 "changelog": "First release",
 "developer": "Leonux Community",
 "permissions": [
  "Runs offline",
  "Sandboxed"
 ],
 "window": {
  "width": 600,
  "height": 520,
  "minWidth": 380,
  "minHeight": 360
 },
 "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Mandelbrot</title><style>*{box-sizing:border-box;margin:0}\n:root{--bg:#10131c;--fg:#e8ecf6;--mut:#8b94ab;--ac:#7EE787;--line:rgba(255,255,255,.1);--card:rgba(255,255,255,.05)}\nhtml,body{height:100%}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(165deg,#10131c,#161a28);color:var(--fg);overflow:hidden;user-select:none;-webkit-user-select:none}\nbutton{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.08);border:1px solid var(--line);border-radius:9px;padding:7px 13px;cursor:pointer;transition:background .12s,transform .08s}\nbutton:hover{background:rgba(255,255,255,.15)}button:active{transform:scale(.96)}\nbutton.pri{background:var(--ac);color:#0b1020;border-color:transparent;font-weight:700}\ninput,select,textarea{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.07);border:1px solid var(--line);border-radius:8px;padding:6px 9px;outline:none;user-select:text;-webkit-user-select:text}\ninput:focus,select:focus,textarea:focus{border-color:var(--ac)}select option{background:#1b2030}\n.wrap{height:100%;display:flex;flex-direction:column;align-items:center;gap:10px;padding:14px;overflow:auto}\n.bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:center}\n.stat{font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:.06em;text-align:center}.stat b{display:block;color:var(--ac);font-size:20px;letter-spacing:0}\nh1{font-size:16px}h1 span{color:var(--ac)}\n.muted{color:var(--mut);font-size:12px}\ncanvas{display:block;max-width:100%}\nlabel{font-size:12px;color:var(--mut)}\n.wrap{padding:10px;gap:8px}canvas{border-radius:8px;cursor:zoom-in;width:100%;flex:1;min-height:0;image-rendering:auto}\n</style></head><body><div class=\"wrap\">\n<div class=\"bar\"><select id=\"mode\"><option value=\"m\">Mandelbrot</option><option value=\"j\">Julia</option></select><select id=\"pal\"><option value=\"0\">Fire</option><option value=\"1\">Ocean</option><option value=\"2\">Neon</option><option value=\"3\">Mono</option></select>\n<label>Iterations <input type=\"range\" id=\"it\" min=\"40\" max=\"800\" value=\"200\"></label><button id=\"reset\">Reset view</button><button id=\"back\">Zoom out</button><span class=\"muted\" id=\"inf\"></span></div>\n<canvas id=\"c\"></canvas><div class=\"muted\">Click to zoom in · drag to pan · wheel to zoom</div>\n</div><script>\nconst cv=document.getElementById('c'),x=cv.getContext('2d'),$=s=>document.querySelector(s);let cx=-.6,cy=0,sc=3.2,job=0,jc=[-.8,.156];\nfunction col(i,max,p){if(i>=max)return[0,0,0];const t=i/48;const f=[(t)=>[255*Math.min(1,t*2),255*Math.max(0,t*1.4-.4),255*Math.max(0,t-.8)*4],(t)=>[40*t*5,150+90*Math.sin(t*3),255],(t)=>[128+127*Math.sin(t*6),128+127*Math.sin(t*6+2.1),128+127*Math.sin(t*6+4.2)],(t)=>{const v=255*(.5+.5*Math.sin(t*5));return[v,v,v]}][p];\n return f(Math.min(t%1+ (p>=2?t:0),p>=2?99:1)).map(v=>Math.max(0,Math.min(255,v)))}\nfunction render(){const id=++job,w=cv.width=Math.max(120,cv.clientWidth/2|0),h=cv.height=Math.max(80,cv.clientHeight/2|0);const img=x.createImageData(w,h),max=+$('#it').value,p=+$('#pal').value,jl=$('#mode').value==='j',asp=h/w;let y=0;\n const chunk=()=>{if(id!==job)return;const end=Math.min(h,y+12);for(;y<end;y++)for(let i=0;i<w;i++){let re=cx+(i/w-.5)*sc,im=cy+(y/h-.5)*sc*asp,a,b;if(jl){a=re;b=im;re=jc[0];im=jc[1]}else{a=b=0}let k=0,a2=0,b2=0;if(jl){a2=a*a;b2=b*b}\n  while(k<max&&a2+b2<4){const t=jl?a*a-b*b+re:a2-b2+re;b=2*a*b+im;a=t;a2=a*a;b2=b*b;k++}const c=col(k,max,p),o=(y*w+i)*4;img.data[o]=c[0];img.data[o+1]=c[1];img.data[o+2]=c[2];img.data[o+3]=255}\n  x.putImageData(img,0,0);if(y<h)setTimeout(chunk,0);else $('#inf').textContent='zoom ×'+(3.2/sc).toFixed(sc<1e-3?0:1)};chunk()}\nfunction at(e){const r=cv.getBoundingClientRect(),asp=r.height/r.width;return[cx+((e.clientX-r.left)/r.width-.5)*sc,cy+((e.clientY-r.top)/r.height-.5)*sc*asp]}\nlet d=null;cv.onpointerdown=e=>{d={x:e.clientX,y:e.clientY,cx,cy,m:false};cv.setPointerCapture(e.pointerId)};\ncv.onpointermove=e=>{if(!d)return;const dx=e.clientX-d.x,dy=e.clientY-d.y;if(Math.abs(dx)+Math.abs(dy)>5)d.m=true;if(d.m){const r=cv.getBoundingClientRect();cx=d.cx-dx/r.width*sc;cy=d.cy-dy/r.width*sc;render()}};\ncv.onpointerup=e=>{if(d&&!d.m){const[a,b]=at(e);cx=a;cy=b;sc/=2.5;render()}d=null};\ncv.onwheel=e=>{e.preventDefault();const[a,b]=at(e);const f=e.deltaY<0?.6:1.6;cx=a+(cx-a)*f;cy=b+(cy-b)*f;sc*=f;render()};\n$('#reset').onclick=()=>{cx=$('#mode').value==='j'?0:-.6;cy=0;sc=3.2;render()};$('#back').onclick=()=>{sc*=2.5;render()};['mode','pal','it'].forEach(i=>$('#'+i).onchange=()=>{if(i==='mode'){cx=$('#mode').value==='j'?0:-.6;cy=0;sc=3.2}render()});\naddEventListener('resize',()=>render());render();\n</script></body></html>\n"
}