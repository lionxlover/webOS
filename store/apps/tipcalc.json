{
 "id": "tipcalc",
 "type": "app",
 "name": "Tip & Split",
 "version": "1.0.0",
 "category": "Finance",
 "icon": "🧾",
 "color": "#fb923c",
 "desc": "Tip and bill splitter for dinner with friends",
 "long": "Choose a tip percentage, set the number of diners and optionally round up each share. Clear totals, nothing more.",
 "changelog": "First release",
 "developer": "Leonux Community",
 "permissions": [
  "Runs offline",
  "Sandboxed"
 ],
 "window": {
  "width": 440,
  "height": 560,
  "minWidth": 340,
  "minHeight": 500
 },
 "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Tip &amp; Split</title><style>*{box-sizing:border-box;margin:0}\n:root{--bg:#10131c;--fg:#e8ecf6;--mut:#8b94ab;--ac:#7EE787;--line:rgba(255,255,255,.1);--card:rgba(255,255,255,.05)}\nhtml,body{height:100%}\nbody{font-family:-apple-system,'Segoe UI',system-ui,sans-serif;background:linear-gradient(165deg,#10131c,#161a28);color:var(--fg);overflow:hidden;user-select:none;-webkit-user-select:none}\nbutton{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.08);border:1px solid var(--line);border-radius:9px;padding:7px 13px;cursor:pointer;transition:background .12s,transform .08s}\nbutton:hover{background:rgba(255,255,255,.15)}button:active{transform:scale(.96)}\nbutton.pri{background:var(--ac);color:#0b1020;border-color:transparent;font-weight:700}\ninput,select,textarea{font:inherit;font-size:13px;color:var(--fg);background:rgba(255,255,255,.07);border:1px solid var(--line);border-radius:8px;padding:6px 9px;outline:none;user-select:text;-webkit-user-select:text}\ninput:focus,select:focus,textarea:focus{border-color:var(--ac)}select option{background:#1b2030}\n.wrap{height:100%;display:flex;flex-direction:column;align-items:center;gap:10px;padding:14px;overflow:auto}\n.bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:center}\n.stat{font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:.06em;text-align:center}.stat b{display:block;color:var(--ac);font-size:20px;letter-spacing:0}\nh1{font-size:16px}h1 span{color:var(--ac)}\n.muted{color:var(--mut);font-size:12px}\ncanvas{display:block;max-width:100%}\nlabel{font-size:12px;color:var(--mut)}\n.wrap{justify-content:center}.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px;width:100%;max-width:380px;display:flex;flex-direction:column;gap:12px}\n.pcts{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}.pcts .on{background:var(--ac);color:#0b1020;font-weight:700}\n.line{display:flex;justify-content:space-between;align-items:center}.stepper{display:flex;align-items:center;gap:10px}.stepper b{min-width:22px;text-align:center}\n.res{background:rgba(0,0,0,.25);border-radius:12px;padding:12px}.res .line{padding:3px 0;font-size:13px}.res .tot{font-size:22px;color:var(--ac);font-weight:800;border-top:1px solid var(--line);margin-top:6px;padding-top:8px}\n</style></head><body><div class=\"wrap\"><div class=\"card\">\n<h1>Tip &amp; <span>Split</span></h1>\n<div class=\"line\"><label>Bill</label><input type=\"number\" id=\"b\" value=\"86.50\" step=\"0.01\" min=\"0\" style=\"width:120px;text-align:right\"></div>\n<label>Tip</label><div class=\"pcts\" id=\"p\"></div>\n<div class=\"line\"><label>Custom %</label><input type=\"number\" id=\"cp\" value=\"18\" min=\"0\" max=\"100\" style=\"width:80px;text-align:right\"></div>\n<div class=\"line\"><label>People</label><div class=\"stepper\"><button id=\"mi\">&minus;</button><b id=\"n\">2</b><button id=\"pl\">+</button></div></div>\n<label class=\"line\"><span>Round up per person</span><input type=\"checkbox\" id=\"ru\"></label>\n<div class=\"res\"><div class=\"line\"><span>Tip</span><b id=\"t\"></b></div><div class=\"line\"><span>Total</span><b id=\"to\"></b></div><div class=\"line tot\"><span>Each pays</span><b id=\"e\"></b></div></div>\n</div></div><script>\nconst $=s=>document.querySelector(s);let pct=18,n=2;\n[10,15,18,20].forEach(v=>{const b=document.createElement('button');b.textContent=v+'%';b.onclick=()=>{pct=v;$('#cp').value=v;calc()};$('#p').appendChild(b)});\nfunction calc(){const bill=+$('#b').value||0;pct=+$('#cp').value||0;const tip=bill*pct/100;let tot=bill+tip,each=tot/n;if($('#ru').checked){each=Math.ceil(each);tot=each*n}\n $('#t').textContent=tip.toFixed(2);$('#to').textContent=tot.toFixed(2);$('#e').textContent=each.toFixed(2);$('#n').textContent=n;\n [...$('#p').children].forEach(b=>b.className=parseInt(b.textContent)==pct?'on':'')}\n$('#mi').onclick=()=>{n=Math.max(1,n-1);calc()};$('#pl').onclick=()=>{n=Math.min(50,n+1);calc()};['#b','#cp','#ru'].forEach(s=>$(s).oninput=calc);calc();\n</script></body></html>\n"
}